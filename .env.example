# Optional shell configuration: copy to .env, edit locally, then run:
# set -a; source .env; set +a
# Python scripts do not load .env automatically.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# LLM_SLEEP_S=0.5

# Azure alternative: set LLM_PROVIDER=azure and fill these instead.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
