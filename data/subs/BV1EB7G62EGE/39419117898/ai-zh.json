{
  "body": [
    {
      "from": 0.1,
      "to": 0.7,
      "content": "求回答"
    },
    {
      "from": 0.7,
      "to": 1.42,
      "content": "好好吃饭"
    },
    {
      "from": 1.42,
      "to": 2.42,
      "content": "来重庆吃饭"
    },
    {
      "from": 2.42,
      "to": 3.02,
      "content": "二探"
    },
    {
      "from": 3.02,
      "to": 3.84,
      "content": "原来好评的店"
    },
    {
      "from": 3.84,
      "to": 5.2,
      "content": "看水平保持怎么样"
    },
    {
      "from": 5.2,
      "to": 6.26,
      "content": "小鹏肥肠鸡"
    },
    {
      "from": 6.26,
      "to": 8.58,
      "content": "251"
    },
    {
      "from": 11.54,
      "to": 13.5,
      "content": "他可真是居民楼下是啊"
    },
    {
      "from": 13.5,
      "to": 14.66,
      "content": "旁边还有健身器材呢"
    },
    {
      "from": 14.66,
      "to": 16.0,
      "content": "刚看他的还是必斯堡"
    },
    {
      "from": 16.0,
      "to": 17.74,
      "content": "上次咱们不是吃过一家肥肠鸡"
    },
    {
      "from": 17.74,
      "to": 18.44,
      "content": "评价还不错"
    },
    {
      "from": 18.44,
      "to": 19.759,
      "content": "这家上榜了5年"
    },
    {
      "from": 19.759,
      "to": 20.639,
      "content": "今年又入围了"
    },
    {
      "from": 20.639,
      "to": 22.079,
      "content": "看看他们保持的怎么样"
    },
    {
      "from": 22.079,
      "to": 24.659,
      "content": "而且他们要求必须得实话实说"
    },
    {
      "from": 24.659,
      "to": 26.259,
      "content": "我反正是有信心的"
    },
    {
      "from": 26.259,
      "to": 27.739,
      "content": "咱们上次来重庆吃的就不错"
    },
    {
      "from": 27.739,
      "to": 28.22,
      "content": "来吧"
    },
    {
      "from": 28.22,
      "to": 29.54,
      "content": "咸蛋黄炒老南瓜"
    },
    {
      "from": 29.54,
      "to": 30.14,
      "content": "25"
    },
    {
      "from": 30.14,
      "to": 31.7,
      "content": "原来没见过这样炒过诶"
    },
    {
      "from": 31.7,
      "to": 34.18,
      "content": "你还别说这俩味道还是真能搭起来的"
    },
    {
      "from": 34.18,
      "to": 36.76,
      "content": "咸蛋黄沙沙的甜咸味没有问题"
    },
    {
      "from": 36.76,
      "to": 38.04,
      "content": "但是它这个南瓜呢是蒸的"
    },
    {
      "from": 38.04,
      "to": 39.64,
      "content": "吃着还是有点水唧唧的"
    },
    {
      "from": 39.64,
      "to": 41.2,
      "content": "一咬南瓜一出水"
    },
    {
      "from": 41.2,
      "to": 43.96,
      "content": "就把那蛋黄那香味啊就全冲淡了"
    },
    {
      "from": 43.96,
      "to": 44.96,
      "content": "这也不难吃啊"
    },
    {
      "from": 44.96,
      "to": 46.8,
      "content": "就没那更好吃"
    },
    {
      "from": 47.28,
      "to": 48.76,
      "content": "麻辣肥肠鸡小锅"
    },
    {
      "from": 48.76,
      "to": 49.48,
      "content": "148"
    },
    {
      "from": 49.48,
      "to": 52.94,
      "content": "土豆炖的特别的软趴"
    },
    {
      "from": 52.94,
      "to": 55.4,
      "content": "入口沙沙的香辣"
    },
    {
      "from": 55.59,
      "to": 58.2,
      "content": "我刚打死了嚯"
    },
    {
      "from": 59.24,
      "to": 60.92,
      "content": "里边这个蔬菜味还真够厚的"
    },
    {
      "from": 60.92,
      "to": 63.12,
      "content": "我还给我压过的海带已经软趴入味了"
    },
    {
      "from": 63.12,
      "to": 64.28,
      "content": "一点脆的感觉没有了"
    },
    {
      "from": 64.28,
      "to": 66.04,
      "content": "尝尝里边的鸡"
    },
    {
      "from": 67.2,
      "to": 68.98,
      "content": "炖的软烂咸香"
    },
    {
      "from": 68.98,
      "to": 69.62,
      "content": "很入味"
    },
    {
      "from": 69.62,
      "to": 72.42,
      "content": "尝尝肥肠就越嚼"
    },
    {
      "from": 72.42,
      "to": 74.86,
      "content": "为啥那香味就在嘴里边就全爆开了"
    },
    {
      "from": 74.86,
      "to": 76.18,
      "content": "越嚼越香那种感觉"
    },
    {
      "from": 76.18,
      "to": 77.4,
      "content": "麻辣有嚼头"
    },
    {
      "from": 77.4,
      "to": 78.26,
      "content": "火候刚刚好"
    },
    {
      "from": 78.26,
      "to": 80.56,
      "content": "就得把咱包点那个方便面拿出来"
    },
    {
      "from": 80.56,
      "to": 82.44,
      "content": "哎这泡面我跟你说真不赖"
    },
    {
      "from": 82.44,
      "to": 83.76,
      "content": "泡一泡一来吧"
    },
    {
      "from": 83.76,
      "to": 85.14,
      "content": "兄弟你爱吃硬的"
    },
    {
      "from": 85.14,
      "to": 87.83,
      "content": "我他也希望了"
    },
    {
      "from": 87.83,
      "to": 92.27000000000001,
      "content": "还有带一点点的那种脆感行"
    },
    {
      "from": 93.84,
      "to": 95.0,
      "content": "喏你行"
    },
    {
      "from": 95.0,
      "to": 95.96000000000001,
      "content": "你倒是还我"
    },
    {
      "from": 95.96000000000001,
      "to": 96.68,
      "content": "你知道吗"
    },
    {
      "from": 98.5,
      "to": 99.24000000000001,
      "content": "这味也行"
    },
    {
      "from": 99.24000000000001,
      "to": 104.12,
      "content": "咱们软的面也好了嚯嗯香拌面"
    },
    {
      "from": 104.12,
      "to": 105.12,
      "content": "它是炸过的"
    },
    {
      "from": 105.12,
      "to": 106.18,
      "content": "他就是吸味吸得多"
    },
    {
      "from": 106.18,
      "to": 109.28,
      "content": "这面条挂着浓浓的麻辣的汤"
    },
    {
      "from": 109.28,
      "to": 110.06,
      "content": "你咬的时候"
    },
    {
      "from": 110.06,
      "to": 112.53999999999999,
      "content": "这汁它已经渗透到90%不到心了"
    },
    {
      "from": 112.53999999999999,
      "to": 113.66,
      "content": "都"
    },
    {
      "from": 115.03999999999999,
      "to": 116.08,
      "content": "好我们做个总结"
    },
    {
      "from": 116.08,
      "to": 117.96000000000001,
      "content": "就是我们吃了251方便面"
    },
    {
      "from": 117.96000000000001,
      "to": 118.88,
      "content": "是我们自己带的啊"
    },
    {
      "from": 118.88,
      "to": 120.84,
      "content": "不过真的建议你们加在菜单上面"
    },
    {
      "from": 120.84,
      "to": 121.86,
      "content": "板件费就不用给了"
    },
    {
      "from": 121.86,
      "to": 124.78,
      "content": "来咱们打个卡走"
    },
    {
      "from": 124.78,
      "to": 125.86,
      "content": "咱们下一家店"
    },
    {
      "from": 128.539,
      "to": 131.28,
      "content": "这个也是咱们原来吃过的"
    },
    {
      "from": 134.94,
      "to": 136.46,
      "content": "嚯真有货"
    },
    {
      "from": 136.46,
      "to": 138.57999999999998,
      "content": "这大骨头大骨头啊"
    },
    {
      "from": 138.57999999999998,
      "to": 139.57999999999998,
      "content": "上回我怎么没吃啊"
    },
    {
      "from": 139.57999999999998,
      "to": 140.9,
      "content": "上回不是说谁吃鸳鸯锅"
    },
    {
      "from": 140.9,
      "to": 142.1,
      "content": "谁的狗吧"
    },
    {
      "from": 143.62,
      "to": 145.6,
      "content": "不过上回好像也是这个屋"
    },
    {
      "from": 145.6,
      "to": 149.22,
      "content": "不是这屋隔壁那个最墙角那个我看见那桌子了"
    },
    {
      "from": 149.22,
      "to": 149.82,
      "content": "还是那个样"
    },
    {
      "from": 149.82,
      "to": 151.74,
      "content": "还是那个位置就没变"
    },
    {
      "from": 151.74,
      "to": 153.68,
      "content": "还是同样的时钟"
    },
    {
      "from": 153.68,
      "to": 155.04,
      "content": "同样的空脚"
    },
    {
      "from": 155.04,
      "to": 156.22,
      "content": "先卤牛蹄筋"
    },
    {
      "from": 156.22,
      "to": 159.05,
      "content": "25奶"
    },
    {
      "from": 160.53,
      "to": 163.61,
      "content": "啊这个串是六毛钱一串五块"
    },
    {
      "from": 163.61,
      "to": 166.19,
      "content": "咱们先来吃这个铁板的"
    },
    {
      "from": 166.75,
      "to": 167.77,
      "content": "卖熟的鸡"
    },
    {
      "from": 167.77,
      "to": 169.63,
      "content": "对小虾仁小虾"
    },
    {
      "from": 169.63,
      "to": 172.31,
      "content": "我一个跟嗑花生比一样"
    },
    {
      "from": 172.31,
      "to": 173.19,
      "content": "是不是有点贫的"
    },
    {
      "from": 173.19,
      "to": 176.32,
      "content": "这个显得很能吃屎啊哈哈"
    },
    {
      "from": 176.32,
      "to": 177.56,
      "content": "虽然没咋地呢"
    },
    {
      "from": 177.56,
      "to": 180.079,
      "content": "不过味还说实话都可以"
    },
    {
      "from": 180.599,
      "to": 183.839,
      "content": "香辣咸鲜辣椒是又辣又香辣的"
    },
    {
      "from": 183.839,
      "to": 184.439,
      "content": "有点刺激"
    },
    {
      "from": 184.439,
      "to": 186.719,
      "content": "看着有点像咱们做的那个辣椒酱"
    },
    {
      "from": 186.719,
      "to": 188.94,
      "content": "那个意思就少点蒜是吧"
    },
    {
      "from": 188.94,
      "to": 189.62,
      "content": "再搁点蒜"
    },
    {
      "from": 189.62,
      "to": 192.0,
      "content": "这有点像这串不跟你们说是什么了"
    },
    {
      "from": 192.0,
      "to": 193.08,
      "content": "包住什么是什么"
    },
    {
      "from": 193.08,
      "to": 197.18,
      "content": "紫苏牛肉母猪说吃的真过瘾"
    },
    {
      "from": 197.18,
      "to": 199.56,
      "content": "锅底还是原来的那么的浓香"
    },
    {
      "from": 199.56,
      "to": 200.3,
      "content": "味儿也厚"
    },
    {
      "from": 200.3,
      "to": 201.72,
      "content": "你看滚出来的油"
    },
    {
      "from": 201.72,
      "to": 203.64,
      "content": "它就好像带点粘稠度似的"
    },
    {
      "from": 203.64,
      "to": 204.72,
      "content": "麻辣鲜香"
    },
    {
      "from": 204.72,
      "to": 206.14,
      "content": "吃起来还是那么香"
    },
    {
      "from": 206.14,
      "to": 207.82,
      "content": "我记得前两年咱俩吃完"
    },
    {
      "from": 207.82,
      "to": 209.86,
      "content": "那咱不是还要往家里面买了"
    },
    {
      "from": 209.86,
      "to": 211.3,
      "content": "可是你没少买"
    },
    {
      "from": 211.3,
      "to": 214.38,
      "content": "他这饮料让你尝不出来某一种香料很突出嗯"
    },
    {
      "from": 214.38,
      "to": 214.9,
      "content": "很舒服"
    },
    {
      "from": 214.9,
      "to": 216.14,
      "content": "老想就多吃点好"
    },
    {
      "from": 216.14,
      "to": 217.06,
      "content": "但是你又不吃吧"
    },
    {
      "from": 217.06,
      "to": 218.16,
      "content": "一停下来就响"
    },
    {
      "from": 218.16,
      "to": 219.24,
      "content": "就那种感觉"
    },
    {
      "from": 219.24,
      "to": 221.39,
      "content": "我昨天一样想嗯"
    },
    {
      "from": 221.39,
      "to": 224.63,
      "content": "这家店上榜了8年了"
    },
    {
      "from": 224.63,
      "to": 226.07,
      "content": "今年也是又入围了"
    },
    {
      "from": 226.07,
      "to": 227.5,
      "content": "这菜还真保持的挺好"
    },
    {
      "from": 227.5,
      "to": 229.06,
      "content": "你看像咱们出去旅游"
    },
    {
      "from": 229.06,
      "to": 230.54,
      "content": "去一个陌生城市看看"
    },
    {
      "from": 230.54,
      "to": 232.34,
      "content": "比之榜真的能省很多事"
    },
    {
      "from": 232.34,
      "to": 233.6,
      "content": "而且这不还挺多年了"
    },
    {
      "from": 233.6,
      "to": 235.74,
      "content": "咱吃的那个肥肠鸡好像也挺多年"
    },
    {
      "from": 235.74,
      "to": 238.52,
      "content": "对吃饭和选店最重要的还是味道"
    },
    {
      "from": 238.52,
      "to": 240.3,
      "content": "连续上榜还代表一个事"
    },
    {
      "from": 240.3,
      "to": 241.5,
      "content": "稳定程度非常的好"
    },
    {
      "from": 241.5,
      "to": 242.4,
      "content": "好吃就对了"
    },
    {
      "from": 242.4,
      "to": 243.46,
      "content": "来咱们下一个菜"
    },
    {
      "from": 243.46,
      "to": 245.72,
      "content": "牛筋油漆哦"
    },
    {
      "from": 245.72,
      "to": 247.04,
      "content": "哇哇哇"
    },
    {
      "from": 247.04,
      "to": 248.56,
      "content": "估计都煮趴了"
    },
    {
      "from": 248.56,
      "to": 250.41,
      "content": "这"
    },
    {
      "from": 252.21,
      "to": 258.69,
      "content": "搁这汤里煮过的那个牛估计真好吃"
    },
    {
      "from": 258.87,
      "to": 260.19,
      "content": "牛筋是先卤过的"
    },
    {
      "from": 260.19,
      "to": 261.35,
      "content": "煮的又耙又糯"
    },
    {
      "from": 261.35,
      "to": 262.66,
      "content": "把那个辣味儿底料"
    },
    {
      "from": 262.66,
      "to": 263.74,
      "content": "这味吸的很足"
    },
    {
      "from": 263.74,
      "to": 264.54,
      "content": "往下吃"
    },
    {
      "from": 264.54,
      "to": 267.34,
      "content": "就是煮牛筋的时候那一点点的酱香"
    },
    {
      "from": 267.34,
      "to": 267.82,
      "content": "这些得多"
    },
    {
      "from": 267.82,
      "to": 269.27,
      "content": "煮完至少要15分钟"
    },
    {
      "from": 269.27,
      "to": 270.35,
      "content": "好我们做个总结"
    },
    {
      "from": 270.35,
      "to": 271.99,
      "content": "这是我们吃的350"
    },
    {
      "from": 271.99,
      "to": 273.75,
      "content": "和几年之前我们吃的差不多啊"
    },
    {
      "from": 273.75,
      "to": 277.12,
      "content": "因为这个锅底啊还在那种非常优秀的梯队里"
    },
    {
      "from": 277.12,
      "to": 278.24,
      "content": "串的变化倒是不大"
    },
    {
      "from": 278.24,
      "to": 279.88,
      "content": "然后咱们食量好像变大了"
    },
    {
      "from": 279.88,
      "to": 281.62,
      "content": "哈哈哈哈哈好嘞"
    },
    {
      "from": 281.62,
      "to": 283.2,
      "content": "大众点评打个卡"
    }
  ]
}
