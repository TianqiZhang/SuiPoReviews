{
  "body": [
    {
      "from": 0.04,
      "to": 2.14,
      "content": "一个视频讲透一个食材"
    },
    {
      "from": 2.14,
      "to": 4.58,
      "content": "今天我们讲的是猪肝"
    },
    {
      "from": 4.58,
      "to": 5.42,
      "content": "很新鲜啊"
    },
    {
      "from": 5.42,
      "to": 6.96,
      "content": "还滴点水的"
    },
    {
      "from": 10.82,
      "to": 12.44,
      "content": "今天我们做三个辣菜"
    },
    {
      "from": 12.44,
      "to": 14.16,
      "content": "重庆的烧椒猪肝"
    },
    {
      "from": 14.16,
      "to": 15.96,
      "content": "湖南的土匪猪肝"
    },
    {
      "from": 15.96,
      "to": 18.56,
      "content": "自贡的肝腰合炒来吧"
    },
    {
      "from": 18.56,
      "to": 19.83,
      "content": "我们先做第一个"
    },
    {
      "from": 23.44,
      "to": 26.84,
      "content": "猪肝切硬币厚的片"
    },
    {
      "from": 29.16,
      "to": 33.62,
      "content": "辣椒掰一下醋的是这种"
    },
    {
      "from": 33.62,
      "to": 34.5,
      "content": "这个也可以啊"
    },
    {
      "from": 34.5,
      "to": 35.02,
      "content": "也可以"
    },
    {
      "from": 35.02,
      "to": 35.94,
      "content": "都没问题"
    },
    {
      "from": 35.94,
      "to": 37.56,
      "content": "你吃很辣一点吗"
    },
    {
      "from": 37.56,
      "to": 40.52,
      "content": "我能吃辣那行"
    },
    {
      "from": 40.52,
      "to": 42.12,
      "content": "还有比我嘴硬行"
    },
    {
      "from": 42.12,
      "to": 43.4,
      "content": "可以呃"
    },
    {
      "from": 43.4,
      "to": 45.939,
      "content": "哈哈哈哈哈好"
    },
    {
      "from": 45.939,
      "to": 48.059,
      "content": "这就可以了哎"
    },
    {
      "from": 48.059,
      "to": 49.419,
      "content": "切点姜末"
    },
    {
      "from": 57.0,
      "to": 60.76,
      "content": "好我们需要把猪肝洗一下"
    },
    {
      "from": 62.6,
      "to": 67.84,
      "content": "胡椒粉盐生抽抓一下"
    },
    {
      "from": 68.84,
      "to": 70.48,
      "content": "放点淀粉"
    },
    {
      "from": 71.759,
      "to": 75.039,
      "content": "辣椒蒜姜也放进一些"
    },
    {
      "from": 76.399,
      "to": 77.799,
      "content": "加点香油"
    },
    {
      "from": 79.08,
      "to": 82.1,
      "content": "表面看着有一层很薄的一层淀粉就行了"
    },
    {
      "from": 82.1,
      "to": 84.46000000000001,
      "content": "下一个我们得做烧焦了"
    },
    {
      "from": 84.46000000000001,
      "to": 85.24,
      "content": "烧干锅"
    },
    {
      "from": 85.24,
      "to": 86.8,
      "content": "把这个辣椒搁进去"
    },
    {
      "from": 86.8,
      "to": 88.009,
      "content": "给它煸炒"
    },
    {
      "from": 91.06,
      "to": 94.22,
      "content": "拿勺拍一下瘪了"
    },
    {
      "from": 94.22,
      "to": 96.74000000000001,
      "content": "他跟那个锅的接触面积就大了"
    },
    {
      "from": 100.46000000000001,
      "to": 104.03999999999999,
      "content": "炒到外面有虎皮变软就行了"
    },
    {
      "from": 104.03999999999999,
      "to": 105.62,
      "content": "这个不是个着急的活"
    },
    {
      "from": 105.62,
      "to": 106.89,
      "content": "看着变色了"
    },
    {
      "from": 106.89,
      "to": 109.25,
      "content": "我闻到烧辣椒的那个香味好了"
    },
    {
      "from": 109.25,
      "to": 110.84,
      "content": "看这个现在就可以了"
    },
    {
      "from": 110.84,
      "to": 113.08,
      "content": "看那个炒这个状态软"
    },
    {
      "from": 113.08,
      "to": 115.22,
      "content": "而且表面变成虎皮色"
    },
    {
      "from": 115.22,
      "to": 116.02000000000001,
      "content": "已经软了"
    },
    {
      "from": 116.02000000000001,
      "to": 118.8,
      "content": "出锅剁一下"
    },
    {
      "from": 121.38,
      "to": 124.0,
      "content": "留点粗的简单剁两刀"
    },
    {
      "from": 124.0,
      "to": 126.26,
      "content": "剩下的得剁一下"
    },
    {
      "from": 127.72,
      "to": 129.539,
      "content": "有粗有细"
    },
    {
      "from": 129.539,
      "to": 131.9,
      "content": "既能让辣椒的味道好融入"
    },
    {
      "from": 131.9,
      "to": 134.18,
      "content": "而且还能保留烧焦本来的口感"
    },
    {
      "from": 134.18,
      "to": 135.18,
      "content": "一定要炒透啊"
    },
    {
      "from": 135.18,
      "to": 137.0,
      "content": "你看我剁了半天也没出水"
    },
    {
      "from": 137.0,
      "to": 138.84,
      "content": "已经完全的炒透了"
    },
    {
      "from": 138.84,
      "to": 140.88,
      "content": "哈哈好"
    },
    {
      "from": 141.88,
      "to": 144.44,
      "content": "我们现在开始炒大火锅"
    },
    {
      "from": 144.44,
      "to": 146.06,
      "content": "里边加入菜籽油"
    },
    {
      "from": 146.38,
      "to": 150.06,
      "content": "下入青花椒蒜姜小米辣"
    },
    {
      "from": 151.78,
      "to": 152.66,
      "content": "炒出香味"
    },
    {
      "from": 155.1,
      "to": 156.57999999999998,
      "content": "放入猪肝"
    },
    {
      "from": 157.88,
      "to": 159.22,
      "content": "不要着急动它"
    },
    {
      "from": 159.22,
      "to": 160.7,
      "content": "看着猪肝变色了"
    },
    {
      "from": 160.7,
      "to": 162.07999999999998,
      "content": "再扒拉它"
    },
    {
      "from": 164.64,
      "to": 165.76,
      "content": "好这样就可以了"
    },
    {
      "from": 168.04,
      "to": 170.04,
      "content": "放入烧焦"
    },
    {
      "from": 172.96,
      "to": 174.4,
      "content": "加点水"
    },
    {
      "from": 174.93,
      "to": 177.25,
      "content": "放凉水的意思是让它的味道更好融入"
