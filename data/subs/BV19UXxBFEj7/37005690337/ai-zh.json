{
  "body": [
    {
      "from": 0.16,
      "to": 1.16,
      "content": "不知道怎么跟你们说"
    },
    {
      "from": 1.16,
      "to": 3.48,
      "content": "前段时间呢我们有一个帮扶小店的计划"
    },
    {
      "from": 3.48,
      "to": 4.32,
      "content": "收到了一个报名"
    },
    {
      "from": 4.32,
      "to": 5.6,
      "content": "本地开了近10年"
    },
    {
      "from": 5.6,
      "to": 6.94,
      "content": "欠了几10万的外债"
    },
    {
      "from": 6.94,
      "to": 8.91,
      "content": "家里还有两位身体不好的老人"
    },
    {
      "from": 8.91,
      "to": 10.71,
      "content": "然后我先让小李来蹲点儿"
    },
    {
      "from": 12.39,
      "to": 15.48,
      "content": "于是我们就来到了河南啊"
    },
    {
      "from": 15.48,
      "to": 17.26,
      "content": "这家是吧"
    },
    {
      "from": 17.26,
      "to": 17.72,
      "content": "对"
    },
    {
      "from": 21.84,
      "to": 23.25,
      "content": "错这么多菜呢"
    },
    {
      "from": 23.25,
      "to": 24.57,
      "content": "有什么本地风味吗"
    },
    {
      "from": 24.57,
      "to": 25.57,
      "content": "陕北炖皮"
    },
    {
      "from": 25.57,
      "to": 28.21,
      "content": "然后有一个300粉皮面条"
    },
    {
      "from": 28.21,
      "to": 29.31,
      "content": "粉条回锅肉"
    },
    {
      "from": 29.31,
      "to": 30.37,
      "content": "来一个这煎吧"
    },
    {
      "from": 30.37,
      "to": 32.63,
      "content": "鱼羊肉特煎巴鱼啊"
    },
    {
      "from": 32.63,
      "to": 34.23,
      "content": "行可以"
    },
    {
      "from": 36.04,
      "to": 38.72,
      "content": "那他这个店一眼看上去的问题都有"
    },
    {
      "from": 38.72,
      "to": 39.5,
      "content": "进来之后"
    },
    {
      "from": 39.5,
      "to": 41.16,
      "content": "你感觉没有什么温度"
    },
    {
      "from": 41.16,
      "to": 42.4,
      "content": "就没有什么人气"
    },
    {
      "from": 42.4,
      "to": 43.64,
      "content": "一个店生意好不好"
    },
    {
      "from": 43.64,
      "to": 44.72,
      "content": "你真的一进来感觉了"
    },
    {
      "from": 44.72,
      "to": 45.56,
      "content": "有没有人气"
    },
    {
      "from": 45.56,
      "to": 48.05,
      "content": "很关键的一个事"
    },
    {
      "from": 48.81,
      "to": 50.11,
      "content": "还是很有感觉的啊"
    },
    {
      "from": 50.11,
      "to": 51.93,
      "content": "有锅气味"
    },
    {
      "from": 53.72,
      "to": 54.72,
      "content": "太好吃了"
    },
    {
      "from": 54.72,
      "to": 57.6,
      "content": "这是把那个粉条泡完之后拌点粉子一蒸"
    },
    {
      "from": 57.6,
      "to": 59.88,
      "content": "蒸完以后炒粉条又软又弹"
    },
    {
      "from": 59.88,
      "to": 60.4,
      "content": "还劲道"
    },
    {
      "from": 60.4,
      "to": 61.56,
      "content": "不糟"
    },
    {
      "from": 62.31,
      "to": 63.03,
      "content": "很香的"
    },
    {
      "from": 63.03,
      "to": 63.75,
      "content": "花椒油的味道"
    },
    {
      "from": 63.75,
      "to": 65.79,
      "content": "有点那个盐味精的没炒化"
    },
    {
      "from": 65.79,
      "to": 68.68,
      "content": "其实再多炒个半分钟就差不多"
    },
    {
      "from": 68.68,
      "to": 70.2,
      "content": "这原谅我的做法"
    },
    {
      "from": 70.2,
      "to": 70.98,
      "content": "盐味精"
    },
    {
      "from": 70.98,
      "to": 71.86,
      "content": "糖胡椒粉"
    },
    {
      "from": 71.86,
      "to": 73.1,
      "content": "醋香油蒜"
    },
    {
      "from": 73.1,
      "to": 75.03999999999999,
      "content": "就这些调料了"
    },
    {
      "from": 76.1,
      "to": 77.1,
      "content": "味道还可以"
    },
    {
      "from": 77.1,
      "to": 79.66,
      "content": "胡椒粉的辣醋的酸是那个原爆里丝"
    },
    {
      "from": 79.66,
      "to": 81.98,
      "content": "那个味粉面吃着很劲道"
    },
    {
      "from": 83.24,
      "to": 85.64,
      "content": "鸡蛋火候煎的也够香味"
    },
    {
      "from": 85.64,
      "to": 86.78,
      "content": "原料更有鸡蛋的"
    },
    {
      "from": 86.78,
      "to": 89.36,
      "content": "不是我想到了很多种可乐"
    },
    {
      "from": 89.36,
      "to": 91.72,
      "content": "我都没想到他的菜做的还可以"
    },
    {
      "from": 91.72,
      "to": 93.88,
      "content": "说实话真的不带亏"
    },
    {
      "from": 100.00999999999999,
      "to": 102.83,
      "content": "哎呀鱼烧的软烂入味"
    },
    {
      "from": 102.83,
      "to": 104.72999999999999,
      "content": "咸香辣"
    },
    {
      "from": 104.72999999999999,
      "to": 105.45,
      "content": "先煎"
    },
    {
      "from": 105.45,
      "to": 106.49000000000001,
      "content": "然后兑汤"
    },
    {
      "from": 106.49000000000001,
      "to": 109.13,
      "content": "炖完汤以后搁里边咕嘟咕嘟小火呢"
    },
    {
      "from": 109.13,
      "to": 109.85,
      "content": "估计咕嘟着"
    },
    {
      "from": 109.85,
      "to": 110.85,
      "content": "我调的挺合适的"
    },
    {
      "from": 110.85,
      "to": 111.95,
      "content": "你看炖的也软烂"
    },
    {
      "from": 111.95,
      "to": 112.9,
      "content": "你给个评价"
    },
    {
      "from": 112.9,
      "to": 114.2,
      "content": "这还挺好吃的"
    },
    {
      "from": 114.2,
      "to": 116.74000000000001,
      "content": "味道调的跟那个鱼肉香味很搭"
    },
    {
      "from": 116.74000000000001,
      "to": 117.5,
      "content": "学起来了"
    },
    {
      "from": 117.5,
      "to": 119.99000000000001,
      "content": "哼哼哼哈哈哈哈哈哈"
    },
    {
      "from": 119.99000000000001,
      "to": 122.57,
      "content": "不是我是真没想到提前过来蹲点"
    },
    {
      "from": 122.57,
      "to": 123.87,
      "content": "全公司开始出动"
    },
    {
      "from": 123.87,
      "to": 125.09,
      "content": "我筛选筛选了那么久"
    },
    {
      "from": 125.09,
      "to": 127.39,
      "content": "唯独没想到他菜做的还不错"
    },
    {
      "from": 128.68,
      "to": 129.539,
      "content": "咋弄啊"
    },
    {
      "from": 129.539,
      "to": 130.199,
      "content": "糖醋里脊"
    },
    {
      "from": 133.4,
      "to": 135.429,
      "content": "哦里边的猪肉还是腌过的"
    },
    {
      "from": 135.429,
      "to": 136.309,
      "content": "淡淡的咸味"
    },
    {
      "from": 136.309,
      "to": 136.789,
      "content": "酸甜味"
    },
    {
      "from": 136.789,
      "to": 138.249,
      "content": "调的一般没有那么厚重"
    },
    {
      "from": 138.249,
      "to": 139.589,
      "content": "糊挂的说得过去"
    },
    {
      "from": 139.589,
      "to": 140.069,
      "content": "着急了"
    },
    {
      "from": 140.069,
      "to": 141.109,
      "content": "稍微再炸一分钟"
    },
    {
      "from": 141.109,
      "to": 141.649,
      "content": "挺好的"
    },
    {
      "from": 141.649,
      "to": 142.949,
      "content": "回锅肉"
    },
    {
      "from": 144.72,
      "to": 146.59,
      "content": "首先为什么要点这个菜"
    },
    {
      "from": 146.59,
      "to": 147.75,
      "content": "店里面生意不太好"
    },
    {
      "from": 147.75,
      "to": 149.53,
      "content": "很容易一存存好几天"
    },
    {
      "from": 149.53,
      "to": 152.89,
      "content": "这个明显的还吃着还是没有那些不好的味道"
    },
    {
      "from": 152.89,
      "to": 153.52,
      "content": "切薄一点"
    },
    {
      "from": 153.52,
      "to": 155.4,
      "content": "这个菜炒的也还可以"
    },
    {
      "from": 155.4,
      "to": 157.36,
      "content": "豆瓣酱的香甜咸香辣"
    },
    {
      "from": 157.36,
      "to": 159.75,
      "content": "表面你看每一块基本上都能挂上酱"
    },
    {
      "from": 159.75,
      "to": 160.99,
      "content": "这吃的味儿特别厚"
    },
    {
      "from": 160.99,
      "to": 162.23,
      "content": "可选的还特别好"
    },
    {
      "from": 162.23,
      "to": 166.47,
      "content": "就是五花三层的还是比外边大部分都做的好"
    },
    {
      "from": 167.43,
      "to": 170.92000000000002,
      "content": "实话我给您建议一定是捡菜得劲"
    },
    {
      "from": 170.92000000000002,
      "to": 173.66,
      "content": "这个呢这一会我给你个比例吧"
    },
    {
      "from": 173.66,
      "to": 174.92000000000002,
      "content": "这个你的甜味够了"
    },
    {
      "from": 174.92000000000002,
      "to": 177.2,
      "content": "就咸味差一点多"
    },
    {
      "from": 177.2,
      "to": 178.56,
      "content": "忙得按工序做"
    },
    {
      "from": 178.56,
      "to": 179.7,
      "content": "之前还找师傅"
    },
    {
      "from": 179.7,
      "to": 181.1,
      "content": "后来就是今年过完年"
    },
    {
      "from": 181.1,
      "to": 182.94,
      "content": "我这师傅实在养不住啊"
    },
    {
      "from": 182.94,
      "to": 185.6,
      "content": "喂可能有一部有一部分10万20万呢"
    },
    {
      "from": 185.6,
      "to": 187.04,
      "content": "现在都是家里人了啊"
    },
    {
      "from": 187.04,
      "to": 188.93,
      "content": "那个社交家属哪有啥媳妇儿"
    },
    {
      "from": 188.93,
      "to": 189.59,
      "content": "哪有啥儿子"
    },
    {
      "from": 189.59,
      "to": 190.65,
      "content": "我的心态非常好"
    },
    {
      "from": 190.65,
      "to": 191.43,
      "content": "不下苦混"
    },
    {
      "from": 191.43,
      "to": 192.33,
      "content": "只要正干"
    },
    {
      "from": 192.33,
      "to": 193.65,
      "content": "没有过不去的坎儿"
    },
    {
      "from": 193.65,
      "to": 195.05,
      "content": "河南话说就是别吓唬他"
    },
    {
      "from": 195.05,
      "to": 195.86,
      "content": "混哈哈"
    },
    {
      "from": 195.86,
      "to": 196.44,
      "content": "只要正干"
    },
    {
      "from": 197.48,
      "to": 198.64,
      "content": "没有过不去的坎"
    },
    {
      "from": 198.64,
      "to": 199.2,
      "content": "加油吧"
    },
    {
      "from": 199.2,
      "to": 199.6,
      "content": "加油吧"
    },
    {
      "from": 199.6,
      "to": 200.5,
      "content": "可坚守住啊"
    },
    {
      "from": 200.5,
      "to": 201.78,
      "content": "好我们做个总结"
    },
    {
      "from": 201.78,
      "to": 204.24,
      "content": "本来我们这个拯救小店计划呢"
    },
    {
      "from": 204.24,
      "to": 207.269,
      "content": "要跟店家同吃同住几天"
    },
    {
      "from": 207.549,
      "to": 208.749,
      "content": "我衣服都带了"
    },
    {
      "from": 208.749,
      "to": 210.50900000000001,
      "content": "结果呢这家店我吃了呀"
    },
    {
      "from": 210.50900000000001,
      "to": 211.589,
      "content": "给他的帮助很少"
    },
    {
      "from": 213.4,
      "to": 214.7,
      "content": "咱们瞧着这条视频"
    },
    {
      "from": 214.7,
      "to": 216.62,
      "content": "当探店视频发了得了啊"
    },
    {
      "from": 216.62,
      "to": 218.44,
      "content": "就这样就这样吧啊"
    }
  ]
