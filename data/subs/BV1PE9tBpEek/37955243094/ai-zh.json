    {
      "from": 39.15,
      "to": 40.33,
      "content": "面条卷着很润"
    },
    {
      "from": 40.33,
      "to": 42.33,
      "content": "就是这味道吃着非常的厚"
    },
    {
      "from": 42.33,
      "to": 43.87,
      "content": "不是弄点挂面煮一煮完"
    },
    {
      "from": 43.87,
      "to": 45.91,
      "content": "弄点酱油汤一兑就叫羊吞面了"
    },
    {
      "from": 45.91,
      "to": 46.79,
      "content": "那不对"
    },
    {
      "from": 46.79,
      "to": 48.37,
      "content": "首先得有猪油吧"
    },
    {
      "from": 48.37,
      "to": 49.97,
      "content": "入口你得香"
