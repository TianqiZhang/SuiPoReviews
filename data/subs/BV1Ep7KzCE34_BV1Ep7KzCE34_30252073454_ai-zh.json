    },
    {
      "from": 27.729,
      "to": 29.129,
      "sid": 12,
      "location": 2,
      "content": "酸甜的味道特别的平衡",
      "music": 0.0
    },
    {
      "from": 29.129,
      "to": 31.889,
      "sid": 13,
      "location": 2,
      "content": "你尝一块肉里边有没有苦腥味啊",
