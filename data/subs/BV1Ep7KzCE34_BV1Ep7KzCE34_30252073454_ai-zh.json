    },
    {
      "from": 47.08,
      "to": 47.86,
      "sid": 20,
      "location": 2,
      "content": "你别闹",
      "music": 0.0
    },
    {
      "from": 47.86,
      "to": 50.56,
      "sid": 21,
      "location": 2,
      "content": "你市场买至少也得35块钱一根吧",
      "music": 0.0
    },
    {
      "from": 50.56,
      "to": 51.75,
      "sid": 22,
      "location": 2,
      "content": "你尝尝错的",
      "music": 0.0
    },
    {
      "from": 53.83,
      "to": 55.43,
      "sid": 23,
      "location": 2,
      "content": "葱打的火稍微差一点",
      "music": 0.0
    },
    {
      "from": 55.43,
      "to": 58.49,
      "sid": 24,
      "location": 2,
      "content": "所以在汤汁里边的葱香味没有那么浓",
