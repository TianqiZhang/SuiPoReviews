  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.32,
      "to": 0.98,
      "sid": 1,
      "location": 2,
      "content": "随拍一单",
      "music": 0.0
    },
    {
      "from": 0.98,
      "to": 1.76,
      "sid": 2,
      "location": 2,
      "content": "好好吃饭",
      "music": 0.0
    },
    {
      "from": 1.76,
      "to": 2.9,
      "sid": 3,
      "location": 2,
      "content": "上海吃本帮菜",
      "music": 0.0
    },
    {
      "from": 2.9,
      "to": 5.64,
      "sid": 4,
      "location": 2,
      "content": "福10883",
      "music": 0.0
    },
    {
      "from": 8.14,
      "to": 9.88,
      "sid": 5,
      "location": 2,
      "content": "今天我带来一个新助手",
      "music": 0.0
    },
    {
      "from": 9.88,
      "to": 13.19,
      "sid": 6,
      "location": 2,
      "content": "这儿呢AI眼镜都显示在眼前了",
      "music": 0.0
    },
    {
      "from": 13.19,
      "to": 16.27,
      "sid": 7,
      "location": 2,
      "content": "小雷小雷推荐一个附近好吃的本帮菜",
      "music": 0.0
    },
    {
      "from": 16.27,
      "to": 17.24,
      "sid": 8,
      "location": 2,
      "content": "福1088",
      "music": 0.0
    },
    {
      "from": 17.24,
      "to": 20.32,
      "sid": 9,
      "location": 2,
      "content": "是一家位于上海的老洋房内的本帮菜餐厅",
      "music": 0.0
    },
    {
      "from": 20.32,
      "to": 21.92,
      "sid": 10,
      "location": 2,
      "content": "前身是福源餐厅",
      "music": 0.0
    },
    {
      "from": 21.92,
      "to": 24.92,
      "sid": 11,
      "location": 2,
      "content": "以提供传统且精致的上海菜而闻名",
      "music": 0.0
    },
    {
      "from": 24.92,
      "to": 26.94,
      "sid": 12,
      "location": 2,
      "content": "导航不行",
      "music": 0.0
    },
    {
      "from": 26.94,
      "to": 29.8,
      "sid": 13,
      "location": 2,
      "content": "它直接就显示在前面了",
      "music": 0.0
    },
    {
      "from": 32.34,
      "to": 34.18,
      "sid": 14,
      "location": 2,
      "content": "今天可是雷鸟推荐的店啊",
      "music": 0.0
    },
    {
      "from": 34.18,
      "to": 35.36,
      "sid": 15,
      "location": 2,
      "content": "要是不好吃",
      "music": 0.0
    },
    {
      "from": 35.36,
      "to": 37.11,
      "sid": 16,
      "location": 2,
      "content": "雷鸟全责啊",
      "music": 0.0
    },
    {
      "from": 37.35,
      "to": 39.61,
      "sid": 17,
      "location": 2,
      "content": "能拍出那种透明色半透明",
      "music": 0.0
    },
    {
      "from": 39.61,
      "to": 41.21,
      "sid": 18,
      "location": 2,
      "content": "你在里边一照挺好的",
      "music": 0.0
    },
    {
      "from": 41.21,
      "to": 42.07,
      "sid": 19,
      "location": 2,
      "content": "肉做的不错",
      "music": 0.0
    },
    {
      "from": 42.07,
      "to": 43.99,
      "sid": 20,
      "location": 2,
      "content": "半透明重要说明什么",
      "music": 0.0
    },
    {
      "from": 43.99,
      "to": 45.1,
      "sid": 21,
      "location": 2,
      "content": "做得好",
      "music": 0.0
    },
    {
      "from": 45.1,
      "to": 46.58,
      "sid": 22,
      "location": 2,
      "content": "选料选的也不错",
      "music": 0.0
    },
    {
      "from": 46.58,
      "to": 47.64,
      "sid": 23,
      "location": 2,
      "content": "火候也炖够了",
      "music": 0.0
    },
    {
      "from": 47.64,
      "to": 49.98,
      "sid": 24,
      "location": 2,
      "content": "师傅在北京饭店做那锅烧肉的时候",
      "music": 0.0
    },
    {
      "from": 49.98,
      "to": 50.86,
      "sid": 25,
      "location": 2,
      "content": "上面一个灯",
      "music": 0.0
    },
    {
      "from": 50.86,
      "to": 54.22,
      "sid": 26,
      "location": 2,
      "content": "下面肉直接能透到那个瘦肉层",
      "music": 0.0
    },
    {
      "from": 54.22,
      "to": 55.269,
      "sid": 27,
      "location": 2,
      "content": "特别的透",
      "music": 0.0
    },
    {
      "from": 55.269,
      "to": 55.949,
      "sid": 28,
      "location": 2,
      "content": "这个我不知道",
      "music": 0.0
    },
    {
      "from": 55.949,
      "to": 56.669,
      "sid": 29,
      "location": 2,
      "content": "你尝一下啊",
      "music": 0.0
    },
    {
      "from": 56.669,
      "to": 58.929,
      "sid": 30,
      "location": 2,
      "content": "下面给大家来一个沉浸式的品尝",
      "music": 0.0
    },
    {
      "from": 58.929,
      "to": 60.789,
      "sid": 31,
      "location": 2,
      "content": "小雷小雷评价一下这道菜",
      "music": 0.0
    },
    {
      "from": 60.789,
      "to": 64.86,
      "sid": 32,
      "location": 2,
      "content": "这位师傅的红烧肉秘诀其实和传统做法差不多",
      "music": 0.0
    },
    {
      "from": 64.86,
      "to": 68.96,
      "sid": 33,
      "location": 2,
      "content": "不过他可能在火候和调味上把控的更细致一些",
      "music": 0.0
    },
    {
      "from": 68.96,
      "to": 71.2,
      "sid": 34,
      "location": 2,
      "content": "比如选料讲究肥瘦比例",
      "music": 0.0
    },
    {
      "from": 71.2,
      "to": 72.92,
      "sid": 35,
      "location": 2,
      "content": "刚好入口不用嚼着",
      "music": 0.0
    },
    {
      "from": 72.92,
      "to": 73.74,
      "sid": 36,
      "location": 2,
      "content": "那肥肉不满",
      "music": 0.0
    },
    {
      "from": 73.74,
      "to": 75.3,
      "sid": 37,
      "location": 2,
      "content": "真的是水嘟嘟水嘟嘟的",
      "music": 0.0
    },
    {
      "from": 75.3,
      "to": 78.1,
      "sid": 38,
      "location": 2,
      "content": "就是肥肉部分一咬还能流出点汁水来",
      "music": 0.0
    },
    {
      "from": 78.1,
      "to": 79.86,
      "sid": 39,
      "location": 2,
      "content": "哎呀这肉炖的挺有意思的",
      "music": 0.0
    },
    {
      "from": 79.86,
      "to": 80.58,
      "sid": 40,
      "location": 2,
      "content": "挺有意思的",
      "music": 0.0
    },
    {
      "from": 80.58,
      "to": 83.06,
      "sid": 41,
      "location": 2,
      "content": "表面的猪皮呢一点腥味都没有",
      "music": 0.0
    },
    {
      "from": 83.06,
      "to": 84.62,
      "sid": 42,
      "location": 2,
      "content": "瘦肉呢吸了肥肉的油脂",
      "music": 0.0
    },
    {
      "from": 84.62,
      "to": 85.38,
      "sid": 43,
      "location": 2,
      "content": "不沾甜味",
      "music": 0.0
    },
    {
      "from": 85.38,
      "to": 85.78,
      "sid": 44,
      "location": 2,
      "content": "很重",
      "music": 0.0
    },
    {
      "from": 85.78,
      "to": 86.46,
      "sid": 45,
      "location": 2,
      "content": "会很甜的",
      "music": 0.0
    },
    {
      "from": 86.46,
      "to": 88.3,
      "sid": 46,
      "location": 2,
      "content": "但是这个甜度是在上海是正常的",
      "music": 0.0
    },
    {
      "from": 88.3,
      "to": 91.06,
      "sid": 47,
      "location": 2,
      "content": "花蜜脆鳝108",
      "music": 0.0
    },
    {
      "from": 92.32,
      "to": 95.16,
      "sid": 48,
      "location": 2,
      "content": "真酥真酥酥的",
      "music": 0.0
    },
    {
      "from": 95.16,
      "to": 97.0,
      "sid": 49,
      "location": 2,
      "content": "你不睁眼看吃的不知道是鳝鱼",
      "music": 0.0
    },
    {
      "from": 97.0,
      "to": 97.83,
      "sid": 50,
      "location": 2,
      "content": "嘿嘿嘿",
      "music": 0.0
    },
    {
      "from": 97.83,
      "to": 98.73,
      "sid": 51,
      "location": 2,
      "content": "鳝鱼片",
      "music": 0.0
    },
    {
      "from": 98.73,
      "to": 102.07,
      "sid": 52,
      "location": 2,
      "content": "把那个很薄的糊下锅炸一个小酸甜的口",
      "music": 0.0
    },
    {
      "from": 103.95,
      "to": 108.88,
      "sid": 53,
      "location": 2,
      "content": "感觉挺好吃的嗯挺好吃嗯",
      "music": 0.0
    },
    {
      "from": 108.88,
      "to": 111.8,
      "sid": 54,
      "location": 2,
      "content": "清炒蟹粉配吐司398",
      "music": 0.0
    },
    {
      "from": 111.8,
      "to": 113.7,
      "sid": 55,
      "location": 2,
      "content": "这蟹粉蟹黄蟹肉",
      "music": 0.0
    },
    {
      "from": 113.7,
      "to": 115.12,
      "sid": 56,
      "location": 2,
      "content": "纯蟹肉蟹黄吗",
      "music": 0.0
    },
    {
      "from": 115.12,
      "to": 117.52,
      "sid": 57,
      "location": 2,
      "content": "纯蟹肉蟹黄这个季节可能要12只蟹",
      "music": 0.0
    },
    {
      "from": 117.52,
      "to": 119.08,
      "sid": 58,
      "location": 2,
      "content": "这你用几只蟹啊",
      "music": 0.0
    },
    {
      "from": 119.08,
      "to": 120.42,
      "sid": 59,
      "location": 2,
      "content": "10~12只",
      "music": 0.0
    },
    {
      "from": 120.42,
      "to": 122.6,
      "sid": 60,
      "location": 2,
      "content": "咱们每天都要拆掉几百斤戏",
      "music": 0.0
    },
    {
      "from": 122.6,
      "to": 123.6,
      "sid": 61,
      "location": 2,
      "content": "我印象当中",
      "music": 0.0
    },
    {
      "from": 123.6,
      "to": 126.28,
      "sid": 62,
      "location": 2,
      "content": "现在的母的6月黄",
      "music": 0.0
    },
    {
      "from": 126.28,
      "to": 129.18,
      "sid": 63,
      "location": 2,
      "content": "怎么也得合40块钱左右一支吧",
      "music": 0.0
    },
    {
      "from": 129.18,
      "to": 130.82,
      "sid": 64,
      "location": 2,
      "content": "比我们我们有二两多吗",
      "music": 0.0
    },
    {
      "from": 130.82,
      "to": 132.06,
      "sid": 65,
      "location": 2,
      "content": "对二两多二两多",
      "music": 0.0
    },
    {
      "from": 132.06,
      "to": 133.2,
      "sid": 66,
      "location": 2,
      "content": "你才卖398",
      "music": 0.0
    },
    {
      "from": 133.2,
      "to": 133.94,
      "sid": 67,
      "location": 2,
      "content": "不够成本",
      "music": 0.0
    },
    {
      "from": 133.94,
      "to": 135.73,
      "sid": 68,
      "location": 2,
      "content": "咱们有蟹腿炒卤水",
      "music": 0.0
    },
    {
      "from": 135.73,
      "to": 138.37,
      "sid": 69,
      "location": 2,
      "content": "蟹肉呢可以做蟹肉豆腐根",
      "music": 0.0
    },
    {
      "from": 138.37,
      "to": 140.01,
      "sid": 70,
      "location": 2,
      "content": "要不然光光卖这个菜嘞",
      "music": 0.0
    },
    {
      "from": 140.01,
      "to": 142.61,
      "sid": 71,
      "location": 2,
      "content": "老板可能是没有利润的",
      "music": 0.0
    },
    {
      "from": 142.61,
      "to": 143.63,
      "sid": 72,
      "location": 2,
      "content": "纯蟹粉啊",
      "music": 0.0
    },
    {
      "from": 143.63,
      "to": 145.05,
      "sid": 73,
      "location": 2,
      "content": "对真的太牛逼了",
      "music": 0.0
    },
    {
      "from": 145.05,
      "to": 145.91,
      "sid": 74,
      "location": 2,
      "content": "他们赔本慢",
      "music": 0.0
    },
    {
      "from": 145.91,
      "to": 148.019,
      "sid": 75,
      "location": 2,
      "content": "那人家那进货渠道不一样",
      "music": 0.0
    },
    {
      "from": 148.019,
      "to": 149.379,
      "sid": 76,
      "location": 2,
      "content": "也许人拿一到手",
      "music": 0.0
    },
    {
      "from": 149.379,
      "to": 150.319,
      "sid": 77,
      "location": 2,
      "content": "我拿了三道手",
      "music": 0.0
    },
    {
      "from": 150.319,
      "to": 151.959,
      "sid": 78,
      "location": 2,
      "content": "我前两天刚考察完价钱",
      "music": 0.0
    },
    {
      "from": 151.959,
      "to": 154.0,
      "sid": 79,
      "location": 2,
      "content": "小雷小雷评价一下这道菜",
      "music": 0.0
    },
    {
      "from": 154.0,
      "to": 157.24,
      "sid": 80,
      "location": 2,
      "content": "这道清炒蟹粉吐司看起来颜色挺丰富的",
      "music": 0.0
    },
    {
      "from": 157.24,
      "to": 158.88,
      "sid": 81,
      "location": 2,
      "content": "蟹粉和吐司搭配的不错",
      "music": 0.0
    },
    {
      "from": 158.88,
      "to": 159.76,
      "sid": 82,
      "location": 2,
      "content": "应该挺好吃的",
      "music": 0.0
    },
    {
      "from": 159.76,
      "to": 161.35,
      "sid": 83,
      "location": 2,
      "content": "你尝了没味道怎么样呀",
      "music": 0.0
    },
    {
      "from": 161.35,
      "to": 165.349,
      "sid": 84,
      "location": 2,
      "content": "尝一口炒的一点腥味都没有",
      "music": 0.0
    },
    {
      "from": 165.349,
      "to": 167.449,
      "sid": 85,
      "location": 2,
      "content": "里边真的是纯蟹肉和雪花",
      "music": 0.0
    },
    {
      "from": 167.449,
      "to": 169.469,
      "sid": 86,
      "location": 2,
      "content": "用南瓜蓉或者胡萝卜调了个颜色",
      "music": 0.0
    },
    {
      "from": 169.469,
      "to": 171.73,
      "sid": 87,
      "location": 2,
      "content": "吃着还有那么一丝丝很甜",
      "music": 0.0
    },
    {
      "from": 171.73,
      "to": 173.31,
      "sid": 88,
      "location": 2,
      "content": "他们说配了个吐司吃",
      "music": 0.0
    },
    {
      "from": 173.31,
      "to": 177.52,
      "sid": 89,
      "location": 2,
      "content": "想起我吃臭豆腐了",
      "music": 0.0
    },
    {
      "from": 180.84,
      "to": 183.36,
      "sid": 90,
      "location": 2,
      "content": "而且配吐司还真挺好吃的是吧",
      "music": 0.0
    },
    {
      "from": 183.36,
      "to": 184.4,
      "sid": 91,
      "location": 2,
      "content": "蟹粉鲜美",
      "music": 0.0
    },
    {
      "from": 184.4,
      "to": 185.26,
      "sid": 92,
      "location": 2,
      "content": "吐司酥脆",
      "music": 0.0
    },
    {
      "from": 185.26,
      "to": 187.62,
      "sid": 93,
      "location": 2,
      "content": "一口下去口感特别丰富",
      "music": 0.0
    },
    {
      "from": 187.62,
      "to": 188.9,
      "sid": 94,
      "location": 2,
      "content": "真的是一种享受呢",
      "music": 0.0
    },
    {
      "from": 188.9,
      "to": 190.3,
      "sid": 95,
      "location": 2,
      "content": "配上这个甜咸味的炒蟹粉",
      "music": 0.0
    },
    {
      "from": 190.3,
      "to": 191.78,
      "sid": 96,
      "location": 2,
      "content": "吃着还挺味道挺和谐",
      "music": 0.0
    },
    {
      "from": 191.78,
      "to": 193.02,
      "sid": 97,
      "location": 2,
      "content": "挺舒服",
      "music": 0.0
    },
    {
      "from": 193.92,
      "to": 196.42,
      "sid": 98,
      "location": 2,
      "content": "这菜卖多少钱啊",
      "music": 0.0
    },
    {
      "from": 196.42,
      "to": 197.48,
      "sid": 99,
      "location": 2,
      "content": "398",
      "music": 0.0
    },
    {
      "from": 197.48,
      "to": 199.71,
      "sid": 100,
      "location": 2,
      "content": "这是比极高的呃",
      "music": 0.0
    },
    {
      "from": 199.71,
      "to": 201.57,
      "sid": 101,
      "location": 2,
      "content": "我是我做不出来",
      "music": 0.0
    },
    {
      "from": 201.57,
      "to": 204.01,
      "sid": 102,
      "location": 2,
      "content": "哈哈哈哈哈哈哈巧了",
      "music": 0.0
    },
    {
      "from": 204.01,
      "to": 204.49,
      "sid": 103,
      "location": 2,
      "content": "你不吃啊",
      "music": 0.0
    },
    {
      "from": 204.49,
      "to": 205.269,
      "sid": 104,
      "location": 2,
      "content": "还减肥",
      "music": 0.0
    },
    {
      "from": 205.269,
      "to": 206.949,
      "sid": 105,
      "location": 2,
      "content": "螃蟹的热量没多少",
      "music": 0.0
    },
    {
      "from": 206.949,
      "to": 208.109,
      "sid": 106,
      "location": 2,
      "content": "蟹粉虽然好吃",
      "music": 0.0
    },
    {
      "from": 208.109,
      "to": 209.709,
      "sid": 107,
      "location": 2,
      "content": "但是热量确实有点高",
      "music": 0.0
    },
    {
      "from": 209.709,
      "to": 211.42,
      "sid": 108,
      "location": 2,
      "content": "不过偶尔吃一点也没关系啦",
      "music": 0.0
    },
    {
      "from": 211.42,
      "to": 214.14,
      "sid": 109,
      "location": 2,
