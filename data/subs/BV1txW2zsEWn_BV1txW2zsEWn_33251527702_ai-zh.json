    },
    {
      "from": 74.42,
      "to": 75.74,
      "sid": 30,
      "location": 2,
      "content": "而不是调料的味道",
      "music": 0.0
    },
    {
      "from": 75.74,
      "to": 77.48,
      "sid": 31,
      "location": 2,
      "content": "葱香肉香都很足",
      "music": 0.0
    },
    {
      "from": 77.48,
      "to": 80.18,
      "sid": 32,
      "location": 2,
      "content": "香啊香好吃吗",
      "music": 0.0
    },
    {
      "from": 80.18,
      "to": 81.16,
      "sid": 33,
      "location": 2,
      "content": "好爽",
      "music": 0.0
    },
    {
      "from": 81.16,
      "to": 82.14,
      "sid": 34,
      "location": 2,
      "content": "昨晚上回家",
      "music": 0.0
    },
