  "body": [
    {
      "from": 0.22,
      "to": 1.78,
      "sid": 1,
      "location": 2,
      "content": "你师爷再不骂我啊",
      "music": 0.0
    },
    {
      "from": 3.26,
      "to": 4.22,
      "sid": 2,
      "location": 2,
      "content": "丢人丢到家了",
      "music": 0.0
    },
    {
      "from": 4.22,
      "to": 7.42,
      "sid": 3,
      "location": 2,
      "content": "都我怎么传的啊",
      "music": 0.0
    },
    {
      "from": 7.82,
      "to": 8.94,
      "sid": 4,
      "location": 2,
      "content": "稍微轻了一点",
      "music": 0.0
    },
    {
      "from": 8.94,
      "to": 10.22,
      "sid": 5,
      "location": 2,
      "content": "这理由太充分了",
      "music": 0.0
    },
    {
      "from": 10.22,
      "to": 11.3,
      "sid": 6,
      "location": 2,
      "content": "就别卖就行了吧",
      "music": 0.0
    },
    {
      "from": 11.3,
      "to": 12.9,
      "sid": 7,
      "location": 2,
      "content": "所老师平时训人凶吗",
      "music": 0.0
    },
    {
      "from": 13.9,
      "to": 14.879,
      "sid": 8,
      "location": 2,
      "content": "凶啊",
      "music": 0.0
    },
    {
      "from": 14.879,
      "to": 15.599,
      "sid": 9,
      "location": 2,
      "content": "随机波",
      "music": 0.0
    },
    {
      "from": 15.599,
      "to": 16.659,
      "sid": 10,
      "location": 2,
      "content": "一大去学去看",
      "music": 0.0
    },
    {
      "from": 16.659,
      "to": 18.539,
      "sid": 11,
      "location": 2,
      "content": "今天带徒弟探徒弟的店",
      "music": 0.0
    },
    {
      "from": 18.539,
      "to": 19.399,
      "sid": 12,
      "location": 2,
      "content": "金山小馆",
      "music": 0.0
    },
    {
      "from": 20.479,
      "to": 23.719,
      "sid": 13,
      "location": 2,
      "content": "欢迎师傅指导工作",
      "music": 0.0
    },
    {
      "from": 30.38,
      "to": 31.34,
      "sid": 14,
      "location": 2,
      "content": "柯兰志啊",
      "music": 0.0
    },
    {
      "from": 31.34,
      "to": 33.52,
      "sid": 15,
      "location": 2,
      "content": "哎师傅我不认识吧",
      "music": 0.0
    },
    {
      "from": 33.52,
      "to": 35.14,
      "sid": 16,
      "location": 2,
      "content": "哎克老师哇",
      "music": 0.0
    },
    {
      "from": 35.14,
      "to": 36.16,
      "sid": 17,
      "location": 2,
      "content": "你还挺有架子",
      "music": 0.0
    },
    {
      "from": 36.16,
      "to": 36.88,
      "sid": 18,
      "location": 2,
      "content": "你俩平辈",
      "music": 0.0
    },
    {
      "from": 36.88,
      "to": 38.2,
      "sid": 19,
      "location": 2,
      "content": "你怎么不站起来啊",
      "music": 0.0
    },
    {
      "from": 39.6,
      "to": 40.46,
      "sid": 20,
      "location": 2,
      "content": "再来一下",
      "music": 0.0
    },
    {
      "from": 42.28,
      "to": 44.48,
      "sid": 21,
      "location": 2,
      "content": "干嘛就站着就行了",
      "music": 0.0
    },
    {
      "from": 44.48,
      "to": 45.8,
      "sid": 22,
      "location": 2,
      "content": "不再录一下吗",
      "music": 0.0
    },
    {
      "from": 45.8,
      "to": 46.94,
      "sid": 23,
      "location": 2,
      "content": "潘长志是这样",
      "music": 0.0
    },
    {
      "from": 46.94,
      "to": 50.16,
      "sid": 24,
      "location": 2,
      "content": "今天呢主要是过来检查你的功课",
      "music": 0.0
    },
    {
      "from": 50.16,
      "to": 50.72,
      "sid": 25,
      "location": 2,
      "content": "好",
      "music": 0.0
    },
    {
      "from": 50.72,
      "to": 52.62,
      "sid": 26,
      "location": 2,
      "content": "自己拿不准的",
      "music": 0.0
    },
    {
      "from": 52.62,
      "to": 54.94,
      "sid": 27,
      "location": 2,
      "content": "可以可以好嗯",
      "music": 0.0
    },
    {
      "from": 54.94,
      "to": 56.9,
      "sid": 28,
      "location": 2,
      "content": "辛苦辛苦好",
      "music": 0.0
    },
    {
      "from": 58.14,
      "to": 63.58,
      "sid": 29,
      "location": 2,
      "content": "哎哈哈哈",
      "music": 0.0
    },
    {
      "from": 63.58,
      "to": 65.519,
      "sid": 30,
      "location": 2,
      "content": "这哎行了",
      "music": 0.0
    },
    {
      "from": 65.519,
      "to": 68.479,
      "sid": 31,
      "location": 2,
      "content": "这徒弟咋看着跟你年龄差不多呢",
      "music": 0.0
    },
    {
      "from": 68.479,
      "to": 69.319,
      "sid": 32,
      "location": 2,
      "content": "是年龄差不多",
      "music": 0.0
    },
    {
      "from": 69.319,
      "to": 70.019,
      "sid": 33,
      "location": 2,
      "content": "没小几岁",
      "music": 0.0
    },
    {
      "from": 70.019,
      "to": 70.959,
      "sid": 34,
      "location": 2,
      "content": "小三岁吧",
      "music": 0.0
    },
    {
      "from": 70.959,
      "to": 72.139,
      "sid": 35,
      "location": 2,
      "content": "师徒不按这个吗",
      "music": 0.0
    },
    {
      "from": 72.139,
      "to": 74.99,
      "sid": 36,
      "location": 2,
      "content": "不按这个啊",
      "music": 0.0
    },
    {
      "from": 74.99,
      "to": 76.73,
      "sid": 37,
      "location": 2,
      "content": "鬼老师平时训人凶嘛",
      "music": 0.0
    },
    {
      "from": 76.73,
      "to": 79.31,
      "sid": 38,
      "location": 2,
      "content": "凶了凶了他凶啊",
      "music": 0.0
    },
    {
      "from": 79.31,
      "to": 80.51,
      "sid": 39,
      "location": 2,
      "content": "凶",
      "music": 0.0
    },
    {
      "from": 81.58,
      "to": 82.42,
      "sid": 40,
      "location": 2,
      "content": "紧张吗",
      "music": 0.0
    },
    {
      "from": 82.42,
      "to": 83.24,
      "sid": 41,
      "location": 2,
      "content": "不紧张啊",
      "music": 0.0
    },
    {
      "from": 83.24,
      "to": 85.7,
      "sid": 42,
      "location": 2,
      "content": "有",
      "music": 0.0
    },
    {
      "from": 90.27,
      "to": 91.97,
      "sid": 43,
      "location": 2,
      "content": "先尝尝这个辣子鸡",
      "music": 0.0
    },
    {
      "from": 91.97,
      "to": 94.11,
      "sid": 44,
      "location": 2,
      "content": "没事嗯",
      "music": 0.0
    },
    {
      "from": 94.11,
      "to": 95.93,
      "sid": 45,
      "location": 2,
      "content": "哎呀快来点",
      "music": 0.0
    },
    {
      "from": 95.93,
      "to": 98.17,
      "sid": 46,
      "location": 2,
      "content": "瞅半天我都馋不行了",
      "music": 0.0
    },
    {
      "from": 98.17,
      "to": 102.77,
      "sid": 47,
      "location": 2,
      "content": "吃饭我不敢吃这个",
      "music": 0.07368420664819973
    },
    {
      "from": 102.77,
      "to": 104.65,
      "sid": 48,
      "location": 2,
      "content": "我问你啊",
      "music": 0.0
    },
    {
      "from": 104.65,
      "to": 107.01,
      "sid": 49,
      "location": 2,
      "content": "那我就斗胆尝一尝了",
      "music": 0.0
    },
    {
      "from": 111.04,
      "to": 112.46,
      "sid": 50,
      "location": 2,
      "content": "尝尝尝尝哎",
      "music": 0.0
    },
    {
      "from": 112.46,
      "to": 113.4,
      "sid": 51,
      "location": 2,
      "content": "就跟他做的似的",
      "music": 0.0
    },
    {
      "from": 115.26,
      "to": 118.61,
      "sid": 52,
      "location": 2,
      "content": "这不是没嗯说啊",
      "music": 0.0
    },
    {
      "from": 118.61,
      "to": 120.43,
      "sid": 53,
      "location": 2,
      "content": "别光吃不说话",
      "music": 0.0
    },
    {
      "from": 120.43,
      "to": 124.15,
      "sid": 54,
      "location": 2,
      "content": "师兄弟之间就没有保留",
      "music": 0.0
    },
    {
      "from": 125.21,
      "to": 130.19,
      "sid": 55,
      "location": 2,
      "content": "好现在下定了某种决心",
      "music": 0.0
    },
    {
      "from": 130.79,
      "to": 133.03,
      "sid": 56,
      "location": 2,
      "content": "这辣子鸡粉吃到嘴里特别酥脆",
      "music": 0.0
    },
    {
      "from": 133.03,
      "to": 134.03,
      "sid": 57,
      "location": 2,
      "content": "骨头都能嚼碎",
      "music": 0.0
    },
    {
      "from": 134.03,
      "to": 137.75,
      "sid": 58,
      "location": 2,
      "content": "麻辣的这个程度很有层次感啊",
      "music": 0.0
    },
    {
      "from": 137.75,
      "to": 140.329,
      "sid": 59,
      "location": 2,
      "content": "就麻辣不是你",
      "music": 0.0
    },
    {
      "from": 140.329,
      "to": 142.489,
      "sid": 60,
      "location": 2,
      "content": "你去品尝别人店的时候",
      "music": 0.0
    },
    {
      "from": 142.489,
      "to": 143.689,
      "sid": 61,
      "location": 2,
      "content": "不是叭叭叭的不停吗",
      "music": 0.0
    },
    {
      "from": 143.689,
      "to": 145.69,
      "sid": 62,
      "location": 2,
      "content": "那酱油的那种香味",
      "music": 0.0
    },
    {
      "from": 145.69,
      "to": 146.05,
      "sid": 63,
      "location": 2,
      "content": "什么香",
      "music": 0.0
    },
    {
      "from": 146.05,
      "to": 147.23,
      "sid": 64,
      "location": 2,
      "content": "酱油酱油啊",
      "music": 0.0
    },
    {
      "from": 147.23,
      "to": 148.63,
      "sid": 65,
      "location": 2,
      "content": "嗯这里不放酱油啊",
      "music": 0.0
    },
    {
      "from": 148.63,
      "to": 151.48,
      "sid": 66,
      "location": 2,
      "content": "就是你吃的那个酱油味是几种调料放到一起",
      "music": 0.0
    },
    {
      "from": 151.48,
      "to": 153.24,
      "sid": 67,
      "location": 2,
      "content": "在锅里烹炒之后才出那个味儿",
      "music": 0.0
    },
    {
      "from": 153.24,
      "to": 155.58,
      "sid": 68,
      "location": 2,
      "content": "这个是一个非常复合的香味",
      "music": 0.0
    },
    {
      "from": 155.58,
      "to": 157.06,
      "sid": 69,
      "location": 2,
      "content": "不光是麻椒",
      "music": 0.0
    },
    {
      "from": 157.06,
      "to": 157.7,
      "sid": 70,
      "location": 2,
      "content": "花椒",
      "music": 0.0
    },
    {
      "from": 157.7,
      "to": 159.14,
      "sid": 71,
      "location": 2,
      "content": "干辣椒出锅",
      "music": 0.0
    },
    {
      "from": 159.14,
      "to": 161.22,
      "sid": 72,
      "location": 2,
      "content": "醋香油蒜花椒",
      "music": 0.0
    },
    {
      "from": 161.22,
      "to": 162.02,
      "sid": 73,
      "location": 2,
      "content": "麻椒的味道",
      "music": 0.0
    },
    {
      "from": 162.02,
      "to": 163.66,
      "sid": 74,
      "location": 2,
      "content": "麻辣味层次感很好",
      "music": 0.0
    },
    {
      "from": 163.66,
      "to": 164.64,
      "sid": 75,
      "location": 2,
      "content": "干辣椒几重啊",
      "music": 0.0
    },
    {
      "from": 164.64,
      "to": 165.86,
      "sid": 76,
      "location": 2,
      "content": "花椒麻椒几重啊",
      "music": 0.0
    },
    {
      "from": 165.86,
      "to": 168.93,
      "sid": 77,
      "location": 2,
      "content": "一定得往细了看下一个啊",
      "music": 0.0
    },
    {
      "from": 168.93,
      "to": 171.09,
      "sid": 78,
      "location": 2,
      "content": "哪天我过来找你学一学",
      "music": 0.0
    },
    {
      "from": 171.09,
      "to": 176.11,
      "sid": 79,
      "location": 2,
      "content": "好的好的榴莲甜烧白好吃",
      "music": 0.0
    },
    {
      "from": 178.43,
      "to": 182.36,
      "sid": 80,
      "location": 2,
      "content": "这种甜烧白肉是不是就稍微的要肥一点",
      "music": 0.0
    },
    {
      "from": 182.36,
      "to": 185.8,
      "sid": 81,
      "location": 2,
      "content": "这点算你蒙对了哈",
      "music": 0.0
    },
    {
      "from": 185.8,
      "to": 187.7,
      "sid": 82,
      "location": 2,
      "content": "五花肉中间夹着榴莲肉",
      "music": 0.0
    },
    {
      "from": 187.7,
      "to": 189.64,
      "sid": 83,
      "location": 2,
      "content": "整个味道非常融合的米饭",
      "music": 0.0
    },
    {
      "from": 189.64,
      "to": 191.28,
      "sid": 84,
      "location": 2,
      "content": "也有淡淡的榴莲的味道",
      "music": 0.0
    },
    {
      "from": 191.28,
      "to": 192.96,
      "sid": 85,
      "location": 2,
      "content": "合适感觉就是你吃的怎么样",
      "music": 0.0
    },
    {
      "from": 192.96,
      "to": 196.2,
      "sid": 86,
      "location": 2,
      "content": "就是那个肉的盐味稍微轻了一点嗯",
      "music": 0.0
    },
    {
      "from": 196.2,
      "to": 199.64,
      "sid": 87,
      "location": 2,
      "content": "米饭的那个榴莲味儿感觉还是要差点的",
      "music": 0.0
    },
    {
      "from": 199.64,
      "to": 200.52,
      "sid": 88,
      "location": 2,
      "content": "比克为标准",
      "music": 0.0
    },
    {
      "from": 200.52,
      "to": 203.62,
      "sid": 89,
      "location": 2,
      "content": "下边这个糯米饭一斤放多少克榴莲",
      "music": 0.0
    },
    {
      "from": 203.62,
      "to": 204.92,
      "sid": 90,
      "location": 2,
      "content": "那下边人怎么操作呀",
      "music": 0.0
    },
    {
      "from": 204.92,
      "to": 205.56,
      "sid": 91,
      "location": 2,
      "content": "再甜一点",
      "music": 0.0
    },
    {
      "from": 205.56,
      "to": 207.05,
      "sid": 92,
      "location": 2,
      "content": "我放多少甜啊",
      "music": 0.0
    },
    {
      "from": 207.05,
      "to": 208.19,
      "sid": 93,
      "location": 2,
      "content": "下一个吧",
      "music": 0.0
    },
    {
      "from": 208.19,
      "to": 209.97,
      "sid": 94,
      "location": 2,
      "content": "最近销量有点大",
      "music": 0.0
    },
    {
      "from": 209.97,
      "to": 212.83,
      "sid": 95,
      "location": 2,
      "content": "纯肉那牛眼为啥上去销量大",
      "music": 0.0
    },
    {
      "from": 212.83,
      "to": 214.75,
      "sid": 96,
      "location": 2,
      "content": "你又这理由又太充分了",
      "music": 0.0
    },
    {
      "from": 214.75,
      "to": 216.38,
      "sid": 97,
      "location": 2,
      "content": "你别卖就行了吧",
      "music": 0.0
    },
    {
      "from": 216.38,
      "to": 220.56,
      "sid": 98,
      "location": 2,
      "content": "你这个事你师爷再不骂我啊",
      "music": 0.0
    },
    {
      "from": 220.56,
      "to": 221.82,
      "sid": 99,
      "location": 2,
      "content": "我怎么传的啊",
      "music": 0.0
    },
    {
      "from": 221.82,
      "to": 224.51,
      "sid": 100,
      "location": 2,
      "content": "师爷也是做了一手的好川菜",
      "music": 0.0
    },
    {
      "from": 224.51,
      "to": 225.91,
      "sid": 101,
      "location": 2,
      "content": "好明白",
      "music": 0.0
    },
    {
      "from": 225.91,
      "to": 227.73,
      "sid": 102,
      "location": 2,
      "content": "还卖的多了",
      "music": 0.0
    },
    {
      "from": 227.73,
      "to": 229.13,
      "sid": 103,
      "location": 2,
      "content": "这个就是五花肉",
      "music": 0.0
    },
    {
      "from": 229.13,
      "to": 230.53,
      "sid": 104,
      "location": 2,
      "content": "炸完之后加了榴莲肉",
      "music": 0.0
    },
    {
      "from": 230.53,
      "to": 232.45,
      "sid": 105,
      "location": 2,
      "content": "然后来蒸出来是对对对对",
      "music": 0.0
    },
    {
      "from": 232.45,
      "to": 235.13,
      "sid": 106,
      "location": 2,
      "content": "上面撒了一点这个绵白糖",
      "music": 0.0
    },
    {
      "from": 237.849,
      "to": 239.409,
      "sid": 107,
      "location": 2,
      "content": "你又出问题了",
      "music": 0.0
    },
    {
      "from": 239.409,
      "to": 241.029,
      "sid": 108,
      "location": 2,
      "content": "上面是绵白糖吗",
      "music": 0.0
    },
    {
      "from": 241.029,
      "to": 243.26,
      "sid": 109,
      "location": 2,
      "content": "砂糖是问我呢",
      "music": 0.0
    },
    {
      "from": 244.52,
      "to": 246.34,
      "sid": 110,
      "location": 2,
      "content": "所以算了",
      "music": 0.0
    },
    {
      "from": 246.34,
      "to": 248.54,
      "sid": 111,
      "location": 2,
      "content": "我咋我我感觉我都要丢丢人",
      "music": 0.0
    },
    {
      "from": 248.54,
      "to": 249.14,
