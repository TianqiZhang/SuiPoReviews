    },
    {
      "from": 11.24,
      "to": 12.62,
      "sid": 6,
      "location": 2,
      "content": "这个师傅估计值得",
      "music": 0.0
    },
    {
      "from": 12.62,
      "to": 13.5,
      "sid": 7,
      "location": 2,
      "content": "我们晚上要来",
      "music": 0.0
    },
    {
      "from": 13.5,
      "to": 16.42,
      "sid": 8,
      "location": 2,
      "content": "最起码中午就把那个鸭子也烤好了",
      "music": 0.0
    },
    {
      "from": 16.55,
      "to": 17.93,
      "sid": 9,
      "location": 2,
      "content": "拜拜啦",
      "music": 0.0
    },
    {
      "from": 17.93,
      "to": 19.58,
      "sid": 10,
      "location": 2,
      "content": "肉干柴",
      "music": 0.0
    },
    {
      "from": 19.58,
      "to": 21.96,
      "sid": 11,
      "location": 2,
      "content": "你看这肉都已经这色儿了吧",
      "music": 0.0
    },
    {
      "from": 21.96,
      "to": 24.26,
      "sid": 12,
      "location": 2,
      "content": "回炉重烤的就是先嘘一下",
      "music": 0.0
    },
    {
      "from": 24.26,
      "to": 25.82,
      "sid": 13,
      "location": 2,
      "content": "嘘完以后在那放着",
      "music": 0.0
    },
    {
      "from": 25.82,
      "to": 28.06,
      "sid": 14,
      "location": 2,
      "content": "然后做菜的时候啪一续一下热的",
      "music": 0.0
    },
    {
      "from": 28.06,
      "to": 30.18,
      "sid": 15,
      "location": 2,
      "content": "我们之前在哪吃过这种鸭子",
      "music": 0.0
    },
    {
      "from": 30.18,
      "to": 31.46,
      "sid": 16,
      "location": 2,
      "content": "一挤好多油",
      "music": 0.0
    },
    {
      "from": 31.46,
      "to": 32.14,
      "sid": 17,
      "location": 2,
      "content": "四喜丸子",
      "music": 0.0
    },
    {
      "from": 32.14,
      "to": 34.16,
      "sid": 18,
      "location": 2,
      "content": "48中间包了一个咸蛋黄",
      "music": 0.0
    },
    {
      "from": 34.16,
      "to": 37.33,
      "sid": 19,
      "location": 2,
      "content": "我吃老地瓜思想情节",
      "music": 0.0
    },
    {
      "from": 37.33,
      "to": 38.55,
      "sid": 20,
      "location": 2,
      "content": "你看这个蛋黄啊",
      "music": 0.0
    },
    {
      "from": 38.55,
      "to": 40.71,
      "sid": 21,
      "location": 2,
      "content": "这个丸子估计做了有两天了",
      "music": 0.0
    },
    {
      "from": 40.71,
      "to": 42.489,
      "sid": 22,
      "location": 2,
      "content": "记的人去世",
      "music": 0.0
    },
    {
      "from": 42.489,
      "to": 44.289,
      "sid": 23,
      "location": 2,
      "content": "这当天做的呀",
      "music": 0.0
    },
    {
      "from": 44.289,
      "to": 45.969,
      "sid": 24,
      "location": 2,
      "content": "他这个肉香味是特别足的",
      "music": 0.0
    },
    {
      "from": 45.969,
      "to": 47.4,
      "sid": 25,
      "location": 2,
      "content": "这个放的时间长了之后啊",
      "music": 0.0
    },
    {
      "from": 47.4,
      "to": 49.42,
      "sid": 26,
      "location": 2,
      "content": "就是肉里边就是调料味太重了",
      "music": 0.0
    },
    {
      "from": 49.42,
      "to": 50.48,
      "sid": 27,
      "location": 2,
      "content": "就太渗透了",
      "music": 0.0
    },
    {
      "from": 50.48,
      "to": 52.24,
      "sid": 28,
      "location": 2,
      "content": "吃不出来肉的本身的那种香味",
      "music": 0.0
    },
    {
      "from": 52.24,
      "to": 54.46,
      "sid": 29,
      "location": 2,
      "content": "一抿就像吃那个午餐肉似的",
      "music": 0.0
    },
    {
      "from": 54.46,
      "to": 55.68,
      "sid": 30,
      "location": 2,
      "content": "但这不是不新鲜啊",
      "music": 0.0
    },
    {
      "from": 55.68,
      "to": 56.52,
      "sid": 31,
      "location": 2,
      "content": "不是不新鲜啊",
      "music": 0.0
    },
    {
      "from": 56.52,
      "to": 59.08,
      "sid": 32,
      "location": 2,
      "content": "他那桌那个鲤鱼是不是也是复杂的",
      "music": 0.0
    },
    {
      "from": 59.08,
      "to": 59.72,
      "sid": 33,
      "location": 2,
      "content": "甩味重",
      "music": 0.0
    },
    {
      "from": 59.72,
      "to": 61.18,
      "sid": 34,
      "location": 2,
      "content": "有两种可能嗯",
      "music": 0.0
    },
    {
      "from": 61.18,
      "to": 63.04,
      "sid": 35,
      "location": 2,
      "content": "一种是有不太干净",
      "music": 0.0
    },
    {
      "from": 63.04,
      "to": 64.02,
      "sid": 36,
      "location": 2,
      "content": "一种是复杂",
      "music": 0.0
    },
    {
      "from": 64.02,
      "to": 65.22,
      "sid": 37,
      "location": 2,
      "content": "主要这个挺好玩",
      "music": 0.0
    },
    {
      "from": 65.22,
      "to": 67.28,
      "sid": 38,
      "location": 2,
      "content": "就是以后也不用自己点菜了",
      "music": 0.0
    },
    {
      "from": 67.88,
      "to": 69.46,
      "sid": 39,
      "location": 2,
      "content": "这个方便弄多点啥",
      "music": 0.0
    },
    {
      "from": 69.46,
      "to": 72.85,
      "sid": 40,
      "location": 2,
      "content": "咱就直接这个要是干净油炸的",
      "music": 0.0
    },
    {
      "from": 72.85,
      "to": 74.41,
      "sid": 41,
      "location": 2,
      "content": "这个鱼估计就苦了",
      "music": 0.0
    },
    {
      "from": 74.41,
      "to": 75.93,
      "sid": 42,
      "location": 2,
      "content": "咱们这种色叫苦了",
      "music": 0.0
    },
    {
      "from": 75.93,
      "to": 77.63,
      "sid": 43,
      "location": 2,
      "content": "你老干省不了药费了",
      "music": 0.0
    },
    {
      "from": 79.139,
      "to": 80.859,
      "sid": 44,
      "location": 2,
      "content": "爆炒腰花78",
      "music": 0.0
    },
    {
      "from": 80.859,
      "to": 81.939,
      "sid": 45,
      "location": 2,
      "content": "你看这个刀工啊",
      "music": 0.0
    },
    {
      "from": 81.939,
      "to": 83.279,
      "sid": 46,
      "location": 2,
      "content": "搁北京都不算好的",
      "music": 0.0
    },
    {
      "from": 83.279,
      "to": 87.49,
      "sid": 47,
      "location": 2,
      "content": "如果如果还做这",
      "music": 0.0
    },
    {
      "from": 87.97,
      "to": 90.51,
      "sid": 48,
      "location": 2,
      "content": "这个跟咱中午吃的一样吗",
      "music": 0.0
    },
    {
      "from": 90.51,
      "to": 91.47,
      "sid": 49,
      "location": 2,
      "content": "不一样",
      "music": 0.0
    },
    {
      "from": 91.47,
      "to": 92.73,
      "sid": 50,
      "location": 2,
      "content": "这个醋味太重",
      "music": 0.0
    },
    {
      "from": 92.73,
      "to": 95.33,
      "sid": 51,
      "location": 2,
      "content": "我估计他得放到38到40克了",
      "music": 0.0
    },
    {
      "from": 95.33,
      "to": 98.51,
      "sid": 52,
      "location": 2,
      "content": "估计你看里边很多的汁芡有点糊嘴了",
