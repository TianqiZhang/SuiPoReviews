    },
    {
      "from": 26.3,
      "to": 27.9,
      "sid": 10,
      "location": 2,
      "content": "咸香一点点的辣菜",
      "music": 0.0
    },
    {
      "from": 27.9,
      "to": 29.82,
      "sid": 11,
      "location": 2,
      "content": "卖相看着都挺大排档的",
      "music": 0.0
    },
    {
      "from": 29.82,
      "to": 32.84,
      "sid": 12,
      "location": 2,
      "content": "但是味道做的还行哎卖相真的很一般",
      "music": 0.0
    },
    {
      "from": 32.84,
      "to": 35.48,
      "sid": 13,
      "location": 2,
      "content": "韭菜炒海肠98",
      "music": 0.0
    },
    {
      "from": 37.55,
      "to": 39.55,
      "sid": 14,
      "location": 2,
      "content": "这菜有点老不好嚼",
      "music": 0.0
    },
    {
      "from": 39.55,
      "to": 40.95,
      "sid": 15,
      "location": 2,
      "content": "跟草似海",
      "music": 0.0
    },
    {
      "from": 40.95,
      "to": 42.61,
      "sid": 16,
      "location": 2,
      "content": "茶脆咸香",
      "music": 0.0
    },
    {
      "from": 42.61,
      "to": 43.35,
      "sid": 17,
      "location": 2,
      "content": "没毛病啊",
      "music": 0.0
    },
    {
      "from": 43.35,
      "to": 44.51,
      "sid": 18,
      "location": 2,
      "content": "这个季节的韭菜呢",
      "music": 0.0
    },
    {
      "from": 44.51,
      "to": 45.89,
      "sid": 19,
      "location": 2,
      "content": "它日照太足了",
      "music": 0.0
    },
    {
      "from": 45.89,
      "to": 47.02,
      "sid": 20,
      "location": 2,
      "content": "别叫特别柴",
      "music": 0.0
    },
    {
      "from": 47.02,
      "to": 48.2,
      "sid": 21,
      "location": 2,
      "content": "要精挑细选",
      "music": 0.0
    },
    {
      "from": 48.2,
      "to": 50.28,
      "sid": 22,
      "location": 2,
      "content": "得选那个像大棚子那个似的",
      "music": 0.0
    },
    {
      "from": 50.28,
      "to": 52.12,
      "sid": 23,
      "location": 2,
      "content": "但是这个季节很少有人种大棚啊",
      "music": 0.0
    },
    {
      "from": 52.12,
      "to": 54.42,
      "sid": 24,
      "location": 2,
      "content": "咸蛋黄鸡翅58",
      "music": 0.0
    },
    {
      "from": 55.78,
      "to": 57.9,
      "sid": 25,
      "location": 2,
      "content": "外边咸蛋黄非常的香",
      "music": 0.0
    },
    {
      "from": 57.9,
      "to": 60.12,
      "sid": 26,
      "location": 2,
      "content": "表面有一个很薄的这么一个脆壳",
      "music": 0.0
    },
    {
      "from": 60.12,
      "to": 62.66,
      "sid": 27,
      "location": 2,
      "content": "里边的鸡翅水分特别足",
      "music": 0.0
    },
    {
      "from": 63.67,
      "to": 65.63,
      "sid": 28,
      "location": 2,
      "content": "现做的现做的",
      "music": 0.0
    },
    {
      "from": 65.63,
      "to": 67.39,
      "sid": 29,
      "location": 2,
      "content": "他的鸡腿就多是吧",
      "music": 0.0
    },
    {
      "from": 67.39,
      "to": 69.19,
      "sid": 30,
      "location": 2,
      "content": "而且中间温度非常高",
      "music": 0.0
    },
    {
      "from": 69.19,
      "to": 71.23,
      "sid": 31,
      "location": 2,
      "content": "这一咬开里边就是热蒸汽",
      "music": 0.0
    },
    {
      "from": 71.23,
      "to": 73.05,
      "sid": 32,
      "location": 2,
      "content": "主要还是咸蛋黄香是吧",
      "music": 0.0
    },
    {
      "from": 73.05,
      "to": 77.43,
      "sid": 33,
      "location": 2,
      "content": "嗯嗯嗯嗯嗯嚯还挺舒服的",
      "music": 0.0
    },
    {
      "from": 77.43,
      "to": 79.29,
      "sid": 34,
      "location": 2,
      "content": "这就跟我的官方大流量卡一样",
      "music": 0.0
    },
    {
      "from": 79.29,
      "to": 80.61,
      "sid": 35,
      "location": 2,
      "content": "吃着超级舒服",
      "music": 0.0
    },
    {
      "from": 80.61,
      "to": 82.08,
      "sid": 36,
      "location": 2,
      "content": "月租最多29元",
      "music": 0.0
    },
    {
      "from": 82.08,
      "to": 83.42,
      "sid": 37,
      "location": 2,
      "content": "每月上百亿流量",
      "music": 0.0
    },
    {
      "from": 83.42,
      "to": 85.04,
      "sid": 38,
      "location": 2,
      "content": "算下来一季才一毛钱",
      "music": 0.0
    },
    {
      "from": 85.04,
      "to": 87.28,
      "sid": 39,
      "location": 2,
      "content": "省下的钱够吃好几顿大餐了",
      "music": 0.0
    },
    {
      "from": 87.28,
      "to": 88.449,
      "sid": 40,
      "location": 2,
      "content": "套餐是不错",
      "music": 0.0
    },
    {
      "from": 88.449,
      "to": 90.309,
      "sid": 41,
      "location": 2,
      "content": "就怕像以前办的卡那样",
      "music": 0.0
    },
    {
      "from": 90.309,
      "to": 91.509,
      "sid": 42,
      "location": 2,
      "content": "后面限速涨价",
      "music": 0.0
    },
    {
      "from": 91.509,
      "to": 92.909,
      "sid": 43,
      "location": 2,
      "content": "你得找正规渠道",
      "music": 0.0
    },
    {
      "from": 92.909,
      "to": 94.509,
      "sid": 44,
      "location": 2,
      "content": "我这张是流量卡评测",
      "music": 0.0
    },
    {
      "from": 94.509,
      "to": 96.98,
      "sid": 45,
      "location": 2,
      "content": "头部up主流量卡忽悠推荐的",
      "music": 0.0
    },
    {
      "from": 96.98,
      "to": 99.96,
      "sid": 46,
      "location": 2,
      "content": "他可是有运营商官方授权的专业靠谱套餐",
      "music": 0.0
    },
    {
      "from": 99.96,
      "to": 100.8,
      "sid": 47,
      "location": 2,
      "content": "是长期优惠",
      "music": 0.0
    },
    {
      "from": 100.8,
      "to": 102.08,
      "sid": 48,
      "location": 2,
      "content": "网速最高500兆",
      "music": 0.0
    },
    {
      "from": 102.08,
      "to": 104.04,
      "sid": 49,
      "location": 2,
      "content": "刷视频玩游戏都流畅",
      "music": 0.0
    },
    {
      "from": 104.04,
      "to": 105.8,
      "sid": 50,
      "location": 2,
      "content": "有问题找客服也负责",
      "music": 0.0
    },
    {
      "from": 105.8,
      "to": 106.56,
      "sid": 51,
      "location": 2,
      "content": "在哪申请",
      "music": 0.0
    },
    {
      "from": 106.56,
      "to": 109.34,
      "sid": 52,
      "location": 2,
      "content": "我现在就要点我置顶链接就能领",
      "music": 0.0
    },
    {
      "from": 109.34,
      "to": 110.74,
      "sid": 53,
      "location": 2,
      "content": "首月免费试用",
