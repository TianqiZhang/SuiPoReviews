{
  "body": [
    {
      "from": 0.22,
      "to": 3.57,
      "content": "油汪汪嗯"
    },
    {
      "from": 4.21,
      "to": 5.45,
      "content": "最后一台好好吃饭"
    },
    {
      "from": 5.45,
      "to": 7.19,
      "content": "新疆围着烤炉吃烤羊"
    },
    {
      "from": 7.19,
      "to": 8.61,
      "content": "380不错啊"
    },
    {
      "from": 8.61,
      "to": 9.81,
      "content": "很香"
    },
    {
      "from": 15.62,
      "to": 16.34,
      "content": "烤全羊"
    },
    {
      "from": 16.34,
      "to": 17.82,
      "content": "看新疆新疆烤羊"
    },
    {
      "from": 17.82,
      "to": 18.42,
      "content": "看玉里"
    },
    {
      "from": 18.42,
      "to": 19.38,
      "content": "咱不看那个"
    },
    {
      "from": 19.38,
      "to": 20.84,
      "content": "咱们只相信自己的嘴"
    },
    {
      "from": 20.84,
      "to": 21.84,
      "content": "实话实说啊"
    },
    {
      "from": 21.84,
      "to": 22.76,
      "content": "但看它闻着挺香"
    },
    {
      "from": 24.56,
      "to": 26.44,
      "content": "我操能闻到味来"
    },
    {
      "from": 27.1,
      "to": 30.1,
      "content": "嚯这麻布片子都有肉香味"
    },
    {
      "from": 30.1,
      "to": 32.99,
      "content": "好了好了嚯"
    },
    {
      "from": 32.99,
      "to": 36.19,
      "content": "哇油汪汪的烤羊排一百六一公斤啊"
    },
    {
      "from": 36.19,
      "to": 36.67,
      "content": "咋了"
    },
    {
      "from": 36.67,
      "to": 38.03,
      "content": "我看一下那皮下脂肪"
    },
    {
      "from": 38.03,
      "to": 39.23,
      "content": "皮下脂肪倍儿白"
    },
    {
      "from": 39.23,
      "to": 39.51,
      "content": "倍儿白"
    },
    {
      "from": 39.51,
      "to": 40.25,
      "content": "跟雪一样"
    },
    {
      "from": 40.25,
      "to": 42.735,
      "content": "这肯定是早上去现杀的样子"
    },
    {
      "from": 44.059,
      "to": 46.199,
      "content": "表面是一层酥脆的壳"
    },
    {
      "from": 46.199,
      "to": 47.679,
      "content": "像饼干油脂"
    },
    {
      "from": 47.679,
      "to": 49.439,
      "content": "烤酥肉有孜然辣椒"
    },
    {
      "from": 49.439,
      "to": 51.36,
      "content": "芝麻香味"
    },
    {
      "from": 52.54,
      "to": 55.62,
      "content": "我看里面汁水还挺多的"
    },
    {
      "from": 56.18,
      "to": 58.22,
      "content": "我这块一咬羊排里的水"
    },
    {
      "from": 58.22,
      "to": 59.9,
      "content": "直接喷到我的口腔里面了"
    },
    {
      "from": 59.9,
      "to": 60.34,
      "content": "真有"
    },
    {
      "from": 60.34,
      "to": 63.76,
      "content": "所以说他连烤再焖四个小时"
    },
    {
      "from": 63.76,
      "to": 66.14,
      "content": "柴火放进去焖两个小时"
    },
    {
      "from": 66.14,
      "to": 68.76,
      "content": "高温先把羊的表面烤定型"
    },
    {
      "from": 68.76,
      "to": 69.74,
      "content": "让那个余温啊"
    },
    {
      "from": 69.74,
      "to": 71.03999999999999,
      "content": "把里边的肉要烤熟"
    },
    {
      "from": 71.03999999999999,
      "to": 72.53999999999999,
      "content": "老旺火烤可能没有水了"
    },
    {
      "from": 72.53999999999999,
      "to": 75.12,
      "content": "就像咱们所谓理解的那种低温慢煮一样"
    },
    {
      "from": 75.12,
      "to": 76.14,
      "content": "低温把它焖熟"
    },
    {
      "from": 76.14,
      "to": 79.0,
      "content": "把里边的水分尽可能的保留在肉里边了"
    },
    {
      "from": 79.0,
      "to": 79.86,
      "content": "真的是香"
    },
    {
      "from": 79.86,
      "to": 82.1,
      "content": "再加上外边皮烤的那个酥香"
    },
    {
      "from": 82.1,
      "to": 82.74,
      "content": "你就吃"
    },
    {
      "from": 82.74,
      "to": 84.26,
      "content": "真的一定得吃"
    },
    {
      "from": 84.26,
      "to": 85.36,
      "content": "这刚出炉的真好"
    },
    {
      "from": 85.36,
      "to": 87.46000000000001,
      "content": "刚出炉的烤包子两块五一个"
    },
    {
      "from": 87.46000000000001,
      "to": 88.14,
      "content": "我这一出去看"
    },
    {
      "from": 88.14,
      "to": 91.37,
      "content": "那小伙拿着那签子嘶嘶哈就在吐呢"
    },
    {
      "from": 91.37,
      "to": 92.21000000000001,
      "content": "就刚出锅"
    },
    {
      "from": 92.21000000000001,
      "to": 94.97999999999999,
      "content": "哈哈好热啊"
    },
    {
      "from": 95.3,
      "to": 97.42,
      "content": "这个我感觉吃这不能这么咬"
    },
    {
      "from": 97.42,
      "to": 100.34,
      "content": "嘘这咬真烫嘴"
    },
    {
      "from": 102.03999999999999,
      "to": 103.6,
      "content": "他们锅锅的豆腐不一样"
    },
    {
      "from": 103.6,
      "to": 104.96000000000001,
      "content": "表皮这个是酥的"
    },
    {
      "from": 104.96000000000001,
      "to": 105.52000000000001,
      "content": "是脆的血"
    },
    {
      "from": 105.52000000000001,
      "to": 108.2,
      "content": "是内壁挂着是烤出的羊肉"
    },
    {
      "from": 108.2,
      "to": 111.75999999999999,
      "content": "那个汁水又咸又香啊"
    },
    {
      "from": 111.75999999999999,
      "to": 114.35,
      "content": "纯肉没配料"
    },
    {
      "from": 114.35,
      "to": 115.96000000000001,
      "content": "咸香肉很香"
    },
    {
      "from": 115.96000000000001,
      "to": 116.68,
      "content": "没有打水"
    },
    {
      "from": 116.68,
      "to": 117.8,
      "content": "直接把肉剁吧"
    },
    {
      "from": 117.8,
      "to": 118.08,
      "content": "剁吧"
    },
    {
      "from": 118.08,
      "to": 119.56,
      "content": "中间都是连着刀排一咬"
    },
    {
      "from": 119.56,
      "to": 120.16,
      "content": "秃噜秃噜的"
    },
    {
      "from": 120.16,
      "to": 122.64,
      "content": "就跟我小时候在家里边吃我奶奶包的饺子似的"
    },
    {
      "from": 122.64,
      "to": 124.5,
      "content": "咽下一口就只能沉下去"
    },
    {
      "from": 124.5,
      "to": 126.88,
      "content": "你不可能你再把它拔出来"
    },
    {
      "from": 127.48,
      "to": 128.84,
      "content": "这是一串肉肉"
    },
    {
      "from": 128.84,
      "to": 129.34,
      "content": "很新鲜"
    },
    {
      "from": 129.34,
      "to": 130.72,
      "content": "皮很香"
    },
    {
      "from": 131.47,
      "to": 135.32,
      "content": "我听你咬的时候就咔嚓一下嗯"
    },
    {
      "from": 136.5,
      "to": 137.18,
      "content": "好吃"
    },
    {
      "from": 137.18,
      "to": 138.18,
      "content": "刚出锅的真香"
    },
    {
      "from": 138.18,
      "to": 139.34,
      "content": "没有腌过膻味"
    },
    {
      "from": 139.34,
      "to": 141.06,
      "content": "没有一点没有"
    },
    {
      "from": 141.6,
      "to": 143.899,
      "content": "真不怕"
    },
    {
      "from": 144.379,
      "to": 147.079,
      "content": "烤的时候大肉疙瘩那才叫烤肉"
    },
    {
      "from": 147.079,
      "to": 149.539,
      "content": "跟那个呲啦呲啦撸签子冒火的"
    },
    {
      "from": 149.539,
      "to": 150.9,
      "content": "那完全是俩风格啊"
    },
    {
      "from": 150.9,
      "to": 152.54,
      "content": "哎呀我想吃一口熟了"
    },
    {
      "from": 152.54,
      "to": 153.56,
      "content": "这块肯定熟了"
    },
    {
      "from": 154.44,
      "to": 156.13,
      "content": "来等下拍摄"
    },
    {
      "from": 156.13,
      "to": 159.03,
      "content": "呵呵呵呵啊"
    },
    {
      "from": 159.03,
      "to": 160.61,
      "content": "花椒孜然辣椒"
    },
    {
      "from": 160.61,
      "to": 161.53,
      "content": "最后肉香"
    },
    {
      "from": 161.53,
      "to": 163.01,
      "content": "这吃着非常的过瘾啊"
    },
    {
      "from": 163.01,
      "to": 164.77,
      "content": "表面烤的焦焦的块儿大"
    },
    {
      "from": 164.77,
      "to": 165.56,
      "content": "但是好嚼"
    },
    {
      "from": 165.56,
      "to": 166.36,
      "content": "没有膻味"
    },
    {
      "from": 166.36,
      "to": 167.6,
      "content": "得亏我劝了一手"
    },
    {
      "from": 167.6,
      "to": 169.04,
      "content": "要不然特写都没法拍"
    },
    {
      "from": 169.04,
      "to": 172.64,
      "content": "丁丁炒面40嗯"
    },
    {
      "from": 172.64,
      "to": 173.66,
      "content": "晚上不拍了啊"
    },
    {
      "from": 173.66,
      "to": 174.3,
      "content": "晚上不拍"
    },
    {
      "from": 174.3,
      "to": 178.24,
      "content": "嘿嘿来新疆的工作效率就是一天只有一磅"
    },
    {
      "from": 178.24,
      "to": 180.5,
      "content": "就是十"
    },
    {
      "from": 183.42,
      "to": 184.44,
      "content": "有点意思"
    },
    {
      "from": 184.44,
      "to": 186.42,
      "content": "里边的青红椒还有玉米粒"
    },
    {
      "from": 186.42,
      "to": 187.0,
      "content": "搁一块"
    },
    {
      "from": 187.0,
      "to": 187.86,
      "content": "里边还有肉丁"
    },
    {
      "from": 187.86,
      "to": 188.84,
      "content": "一口咬下去"
    },
    {
      "from": 188.84,
      "to": 192.1,
      "content": "鲜是西红柿那种酸香辣椒的一点点的辣"
    },
    {
      "from": 192.1,
      "to": 193.26,
      "content": "再咬上这个玉米粒"
    },
    {
      "from": 193.26,
      "to": 196.46,
      "content": "他猛地又爆出了点玉米粒那种香甜"
    },
    {
      "from": 196.46,
      "to": 198.8,
      "content": "口味还非常的丰富啊"
    },
    {
      "from": 199.41,
      "to": 200.95,
      "content": "这你看一个小面筋"
    },
    {
      "from": 200.95,
      "to": 202.17000000000002,
      "content": "我跟你说吃的还很筋道"
    },
    {
      "from": 202.17000000000002,
      "to": 204.2,
      "content": "这吃饱了我你且不饿的"
    },
    {
      "from": 204.2,
      "to": 206.66,
      "content": "这个吃完晚上更拍不了了"
    },
    {
      "from": 206.66,
      "to": 208.16,
      "content": "出门前我还跟他要求"
    },
    {
      "from": 208.16,
      "to": 209.44,
      "content": "这得拍几个呢"
    },
    {
      "from": 209.44,
      "to": 210.16,
      "content": "晚上拍不了"
    },
    {
      "from": 210.16,
      "to": 211.96,
      "content": "晚上拍不了"
    },
    {
      "from": 213.54,
      "to": 216.82,
      "content": "嗯好我们做个总结"
    },
    {
      "from": 216.82,
      "to": 219.69,
      "content": "吃了三百九五个人吃饱了"
    },
    {
      "from": 219.69,
      "to": 221.77,
      "content": "咱们内地来的还是太丢人了"
    },
    {
      "from": 221.77,
      "to": 225.09,
      "content": "我看他们两个本地人都跟他们吃的差不多"
    },
    {
      "from": 227.76,
      "to": 229.46,
      "content": "不过味道确实可以啊"
    },
    {
      "from": 229.46,
      "to": 231.06,
      "content": "一定得吃刚出炉的"
    },
    {
      "from": 231.06,
      "to": 232.44,
      "content": "包括那个烤包子"
    },
    {
      "from": 232.44,
      "to": 233.92000000000002,
      "content": "烤串都非常实用"
    }
  ]
}
