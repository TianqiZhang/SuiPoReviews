{
  "body": [
    {
      "from": 0.08,
      "to": 0.6,
      "content": "夏天了"
    },
    {
      "from": 0.6,
      "to": 2.38,
      "content": "又到吃小龙虾的季节了"
    },
    {
      "from": 2.38,
      "to": 4.42,
      "content": "麻辣的你们在网上看了很多了"
    },
    {
      "from": 4.42,
      "to": 7.84,
      "content": "今天来点不一样的贵州酸汤小龙虾"
    },
    {
      "from": 16.2,
      "to": 17.7,
      "content": "牛逼带跑唉"
    },
    {
      "from": 17.7,
      "to": 19.4,
      "content": "咱们先开始处理小龙虾"
    },
    {
      "from": 19.4,
      "to": 21.22,
      "content": "个人建议你们带个手套啊"
    },
    {
      "from": 21.22,
      "to": 23.2,
      "content": "厚一点的再戴一层一次性手套"
    },
    {
      "from": 23.2,
      "to": 25.71,
      "content": "是因为它不是食品级的是吗是的"
    },
    {
      "from": 25.71,
      "to": 28.17,
      "content": "要是不戴手套会怎么样啊"
    },
    {
      "from": 28.17,
      "to": 31.17,
      "content": "跑点头搭包下线"
    },
    {
      "from": 31.17,
      "to": 33.17,
      "content": "这样一只小龙虾就处理好了"
    },
    {
      "from": 33.17,
      "to": 34.17,
      "content": "如果他老闹腾"
    },
    {
      "from": 34.17,
      "to": 35.41,
      "content": "你把钳子给他搅了多少"
    },
    {
      "from": 35.41,
      "to": 36.39,
      "content": "带点死绸子"
    },
    {
      "from": 40.77,
      "to": 42.65,
      "content": "搅哈哈哈好了"
    },
    {
      "from": 42.65,
      "to": 43.87,
      "content": "我们搅完下头"
    },
    {
      "from": 43.87,
      "to": 45.89,
      "content": "然后咱们就再洗一下"
    },
    {
      "from": 47.58,
      "to": 52.719,
      "content": "这个操作可不可以说我是先烈啊"
    },
    {
      "from": 53.879,
      "to": 55.739,
      "content": "你看这个操作啊"
    },
    {
      "from": 57.02,
      "to": 58.9,
      "content": "小龙虾从中间给它劈开"
    },
    {
      "from": 58.9,
      "to": 59.74,
      "content": "我们要做酸汤的"
    },
    {
      "from": 59.74,
      "to": 61.0,
      "content": "这样呢有几个好处"
    },
    {
      "from": 61.0,
      "to": 63.92,
      "content": "切开之后它的汤汁呢更容易渗到肉里面去"
    },
    {
      "from": 63.92,
      "to": 65.0,
      "content": "很容易入味"
    },
    {
      "from": 65.0,
      "to": 67.4,
      "content": "这个黄也更容易融到汤里边去"
    },
    {
      "from": 67.4,
      "to": 69.64,
      "content": "让这个汤的味道更浓厚一些"
    },
    {
      "from": 69.64,
      "to": 70.48,
      "content": "因为是酸汤"
    },
    {
      "from": 70.48,
      "to": 73.44,
      "content": "小龙虾刀对准头一刀下去"
    },
    {
      "from": 73.44,
      "to": 75.34,
      "content": "而且这么切开之后还方便吃呢"
    },
    {
      "from": 75.34,
      "to": 76.3,
      "content": "拿筷子牙签一挑"
    },
    {
      "from": 77.66,
      "to": 79.28,
      "content": "水里边放点葱姜"
    },
    {
      "from": 79.52,
      "to": 80.86,
      "content": "把小龙虾倒里边"
    },
    {
      "from": 80.86,
      "to": 82.53999999999999,
      "content": "上汽之后蒸上5分钟"
    },
    {
      "from": 82.53999999999999,
      "to": 85.24,
      "content": "这步放葱姜是为了去掉小龙龙虾的腥味"
    },
    {
      "from": 85.24,
      "to": 87.12,
      "content": "水蒸气全是葱姜的味道"
    },
    {
      "from": 87.12,
      "to": 90.16,
      "content": "它会顺着每条缝儿把腥味去掉"
    },
    {
      "from": 90.16,
      "to": 91.0,
      "content": "学学吧"
    },
    {
      "from": 91.0,
      "to": 91.78,
      "content": "学学吧"
    },
    {
      "from": 91.78,
      "to": 93.38,
      "content": "咱们准备做酸汤"
    },
    {
      "from": 93.38,
      "to": 94.42,
      "content": "天这么热"
    },
    {
      "from": 94.42,
      "to": 95.14,
      "content": "睡不好觉"
    },
    {
      "from": 95.14,
      "to": 96.28,
      "content": "感觉吃饭都不香了"
    },
    {
      "from": 96.28,
      "to": 98.82,
      "content": "咱可是有神奇小鹿小兵备的"
    },
    {
      "from": 98.82,
      "to": 99.68,
      "content": "让他给你消消暑"
    },
    {
      "from": 99.68,
      "to": 100.42,
      "content": "开开胃"
    },
    {
      "from": 100.42,
      "to": 102.25999999999999,
      "content": "每次推荐放评论区的券"
    },
    {
      "from": 102.25999999999999,
      "to": 103.7,
      "content": "很快就被冷光了"
    },
    {
      "from": 103.7,
      "to": 104.72,
      "content": "还有粉丝跟我说"
    },
    {
      "from": 104.72,
      "to": 107.16,
      "content": "自己盖的蔬菜给妈妈和小孩都换上了"
    },
    {
      "from": 107.16,
      "to": 108.36,
      "content": "真的很感谢大家的支持"
    },
    {
      "from": 108.36,
      "to": 110.08,
      "content": "趁着小卢夏天最后一波福利"
    },
    {
      "from": 110.08,
      "to": 110.8,
      "content": "赶紧再安排一本"
    },
    {
      "from": 110.8,
      "to": 112.16,
      "content": "我这一条到手才100多"
    },
    {
      "from": 112.16,
      "to": 113.84,
      "content": "我最喜欢它的两面都能盖"
    },
    {
      "from": 113.84,
      "to": 115.32,
      "content": "这A面凉感值够高"
    },
    {
      "from": 115.32,
      "to": 116.96000000000001,
      "content": "裹上真有冰冰凉凉的感觉"
    },
    {
      "from": 116.96000000000001,
      "to": 118.68,
      "content": "B面摸着更软和一些"
    },
    {
      "from": 118.68,
      "to": 120.12,
      "content": "还是A类母婴标准的"
    },
    {
      "from": 120.12,
      "to": 121.68,
      "content": "完全用不着套皮套"
    },
    {
      "from": 121.68,
      "to": 122.72,
      "content": "弄脏了也能机洗"
    },
    {
      "from": 122.72,
      "to": 125.4,
      "content": "不像我以前夏天随便扯一条被子就盖了"
    },
    {
      "from": 125.4,
      "to": 126.24,
      "content": "闷得人一身汗"
    },
    {
      "from": 126.24,
      "to": 128.199,
      "content": "身上还老觉得刺挠和小鹿没法比"
    },
    {
      "from": 128.199,
      "to": 131.18,
      "content": "它里面填充的是天然材料和透气的安心思"
    },
    {
      "from": 131.18,
      "to": 132.66,
      "content": "被窝就像会呼吸一样"
    },
    {
      "from": 132.66,
      "to": 133.12,
      "content": "睡醒了"
    },
    {
      "from": 133.12,
      "to": 134.04,
      "content": "身上特清爽"
    },
    {
      "from": 134.04,
      "to": 134.74,
      "content": "颜色多"
    },
    {
      "from": 134.74,
      "to": 135.6,
      "content": "尺寸也齐全"
    },
    {
      "from": 135.6,
      "to": 136.82,
      "content": "咱和小鹿老朋友了"
    },
    {
      "from": 136.82,
      "to": 137.76,
      "content": "肉厚妥妥的"
    },
    {
      "from": 137.76,
      "to": 138.68,
      "content": "还能保价一年"
    },
    {
      "from": 138.68,
      "to": 140.32,
      "content": "评论领我专属券"
    },
    {
      "from": 140.32,
      "to": 141.36,
      "content": "底价就能到手"
    },
    {
      "from": 141.36,
      "to": 142.24,
      "content": "买到就是赚到了"
    },
    {
      "from": 142.24,
      "to": 146.29,
      "content": "锅中倒油蒜姜"
    },
    {
      "from": 148.81,
      "to": 151.05,
      "content": "炒香之后加入酸汤"
    },
    {
      "from": 151.46,
      "to": 154.38,
      "content": "嘶啊酸汤现在也好买了是吧"
    },
    {
      "from": 154.38,
      "to": 155.74,
      "content": "好买了哦"
    },
    {
      "from": 155.74,
      "to": 157.1,
      "content": "我闻见那个香味了"
    },
    {
      "from": 157.1,
      "to": 159.57999999999998,
      "content": "好香真的好香好"
    },
    {
      "from": 159.57999999999998,
      "to": 161.86,
      "content": "我们加水芹菜"
    },
    {
      "from": 161.86,
      "to": 162.76,
      "content": "西红柿"
    },
    {
      "from": 162.76,
      "to": 164.34,
      "content": "小米辣味精"
    },
    {
      "from": 164.34,
      "to": 166.1,
      "content": "白糖盐"
    },
    {
      "from": 170.82,
      "to": 172.42000000000002,
      "content": "哎这味儿差不多"
    },
    {
      "from": 172.42000000000002,
      "to": 173.3,
      "content": "大火烧开"
    },
    {
      "from": 173.3,
      "to": 174.3,
      "content": "稍微的熬一下"
    },
    {
      "from": 174.3,
      "to": 175.3,
      "content": "蒸好的小龙虾"
    },
    {
      "from": 175.3,
      "to": 176.42000000000002,
      "content": "咱们直接倒到汤里边"
    },
    {
      "from": 176.42000000000002,
      "to": 177.3,
      "content": "太豪横了"
    },
    {
      "from": 177.3,
      "to": 178.88,
      "content": "哥就看这一锅"
    },
    {
      "from": 178.88,
      "to": 181.12,
      "content": "我操香不香吧"
    },
    {
      "from": 181.12,
      "to": 182.34,
      "content": "小火让它煮5分钟"
    },
    {
      "from": 182.34,
      "to": 183.8,
      "content": "入味儿就渗进去"
    },
    {
      "from": 183.8,
      "to": 187.3,
      "content": "你看现在这个汤它已经里边就像肉汤一样"
    },
    {
      "from": 187.3,
      "to": 188.5,
      "content": "你看它已经浑浊了"
    },
    {
      "from": 188.5,
      "to": 190.12,
      "content": "它就是有虾脑那个香味"
    },
    {
      "from": 190.12,
      "to": 191.52,
      "content": "嘿嘿对了哈"
    },
    {
      "from": 191.52,
      "to": 192.04,
      "content": "是的"
    },
    {
      "from": 192.04,
      "to": 197.02,
      "content": "虾配菜豆腐粉丝卷卷炸的腐竹"
    },
    {
      "from": 197.02,
      "to": 198.54,
      "content": "哎你爱吃的方便面"
    },
    {
      "from": 198.54,
      "to": 201.79,
      "content": "木箱子油搁进之后"
    },
    {
      "from": 201.79,
      "to": 202.75,
      "content": "立马这味就出来了"
    },
    {
      "from": 202.75,
      "to": 204.05,
      "content": "很快香啊"
    },
    {
      "from": 204.81,
      "to": 206.23,
      "content": "撒点香菜"
    },
    {
      "from": 207.339,
      "to": 208.779,
      "content": "快吃吧"
    },
    {
      "from": 217.46,
      "to": 219.26,
      "content": "嗯面真入味"
    },
    {
      "from": 219.26,
      "to": 220.78,
      "content": "小龙虾这都不用剥皮"
    },
    {
      "from": 220.78,
      "to": 223.93,
      "content": "拿着筷子一夹一嗦"
    },
    {
      "from": 223.93,
      "to": 225.07,
      "content": "肉掉了倍儿入味"
    },
    {
      "from": 225.07,
      "to": 227.45,
      "content": "酸汤的味道和虾肉的味道完全的融合了"
    },
    {
      "from": 227.45,
      "to": 230.14,
      "content": "它里边是有虾脑的那种鲜的哦"
    },
    {
      "from": 230.14,
      "to": 232.62,
      "content": "你觉得这个这自己夸自己吧"
    },
    {
      "from": 232.62,
      "to": 234.07999999999998,
      "content": "然后我还蒸个米饭"
    },
    {
      "from": 234.07999999999998,
      "to": 235.57,
      "content": "来点汤"
    },
    {
      "from": 235.57,
      "to": 238.65,
      "content": "豆腐粉丝小两卷"
    },
    {
      "from": 238.65,
      "to": 239.65,
      "content": "还有香菜"
    },
    {
      "from": 239.65,
      "to": 240.75,
      "content": "鲜肉香脑一块下"
    },
    {
      "from": 240.75,
      "to": 242.07,
      "content": "这谁顶得住啊"
    },
    {
      "from": 243.225,
      "to": 247.95,
      "content": "噗噗噗噗哎嘶"
    },
    {
      "from": 249.04,
      "to": 251.0,
      "content": "这个汤啊非常之醇厚"
    },
    {
      "from": 251.0,
      "to": 252.46,
      "content": "比一般的酸汤醇厚"
    },
    {
      "from": 252.46,
      "to": 253.76,
      "content": "非常多且鲜"
    },
    {
      "from": 253.76,
      "to": 255.32,
      "content": "然后这个配菜也入味"
    },
    {
      "from": 255.32,
      "to": 256.74,
      "content": "没有丢到酸汤的灵魂"
    },
    {
      "from": 256.74,
      "to": 257.7,
      "content": "下米饭"
    }
  ]
}
