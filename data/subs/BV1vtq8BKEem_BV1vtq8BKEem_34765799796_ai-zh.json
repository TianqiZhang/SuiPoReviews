    },
    {
      "from": 52.35,
      "to": 54.04,
      "sid": 28,
      "location": 2,
      "content": "瞧还有尺子呢",
      "music": 0.0
    },
    {
      "from": 54.04,
      "to": 54.6,
      "sid": 29,
      "location": 2,
      "content": "倍儿标准",
      "music": 0.0
    },
    {
      "from": 55.78,
      "to": 57.56,
      "sid": 30,
      "location": 2,
      "content": "他这么蒸呢就很容易进水",
      "music": 0.0
    },
    {
      "from": 57.56,
      "to": 59.24,
      "sid": 31,
      "location": 2,
      "content": "那菜没炒还不盖膜",
