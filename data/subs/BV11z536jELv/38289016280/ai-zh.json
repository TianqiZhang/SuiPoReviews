    {
      "from": 14.37,
      "to": 15.39,
      "content": "真的生气了吧"
    },
    {
      "from": 15.39,
      "to": 16.57,
      "content": "走这么远不好吃"
    },
    {
      "from": 16.57,
      "to": 17.83,
      "content": "你就在下面洗个澡再走啊"
    },
    {
      "from": 17.83,
      "to": 18.77,
      "content": "他做的不好吃"
    },
    {
      "from": 18.77,
      "to": 19.69,
      "content": "又不是我做的菜"
    },
    {
      "from": 19.69,
      "to": 21.29,
      "content": "你找的呀"
    },
    {
      "from": 22.519,
      "to": 23.939,
      "content": "这水还真清"
    },
    {
      "from": 23.939,
      "to": 25.439,
      "content": "老板开的太帅了"
    },
    {
      "from": 26.879,
      "to": 28.719,
      "content": "现场处理是吧"
    },
    {
      "from": 30.64,
      "to": 33.12,
      "content": "这个是一鱼两吃"
    },
    {
      "from": 33.12,
      "to": 34.96,
      "content": "头尾炖豆腐汤"
    },
    {
      "from": 39.22,
      "to": 41.18,
      "content": "好鲜好香"
    },
    {
      "from": 41.18,
      "to": 42.84,
      "content": "汤都有点挂口"
    },
    {
      "from": 42.84,
      "to": 44.0,
      "content": "鱼汤也不白了"
    },
    {
      "from": 44.0,
      "to": 45.46,
      "content": "倍儿白奶白奶白的"
    },
    {
      "from": 45.46,
      "to": 47.73,
      "content": "然后我给你尝一块鱼肉"
    },
    {
      "from": 49.38,
      "to": 51.12,
      "content": "香非常紧实"
    },
    {
      "from": 51.12,
      "to": 52.02,
      "content": "没有土腥味"
    },
    {
      "from": 53.1,
      "to": 55.7,
      "content": "你看他那个鱼那个水都那么透亮了"
    },
    {
      "from": 55.7,
      "to": 57.22,
      "content": "他就不可能出土腥味了"
    },
    {
      "from": 57.22,
      "to": 58.28,
      "content": "这尝口豆腐"
    },
    {
      "from": 59.42,
      "to": 62.36,
      "content": "豆腐是那种石膏豆腐炖的软滑"
    },
    {
      "from": 62.36,
      "to": 65.239,
      "content": "刚才老板介绍说这鱼啊搁这要养一年"
